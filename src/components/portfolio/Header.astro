---
import p from "../../data/portfolio.json";
import { ThemeToggle } from "../theme-toggle";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(href + "/");
---

<header class="site-header">
  <a
    class="brand"
    href="/"
    aria-label={`a. ${p.profile.brand} — ${p.profile.name} home`}
    ><span class="brand-mark" aria-hidden="true">a.</span><span
      >{p.profile.brand}</span
    ></a
  >
  <nav class="desktop-nav" aria-label="Main navigation">
    {
      p.navLinks.map((link) => (
        <a
          class:list={[isActive(link.href) && "active"]}
          href={link.href}
          aria-current={path === link.href ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
  <div class="header-actions">
    <ThemeToggle /><a class="button small header-cta" href="/contact/"
      >Let's talk <span aria-hidden="true">↗</span></a
    >
    <details class="mobile-menu" id="menu-details">
      <summary
        class="icon-button menu-toggle"
        id="menu-toggle"
        aria-label="Navigation menu"
        aria-controls="mobile-nav"
        ><svg
          aria-hidden="true"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"></path></svg
        ></summary
      ><nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation">
        {
          p.navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={path === link.href ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }<a href="/contact/">Let's talk ↗</a>
      </nav>
    </details>
  </div>
</header>
<noscript
  ><style>
    #theme-toggle {
      display: none;
    }
  </style></noscript
>
<script>
  const theme = document.querySelector<HTMLButtonElement>("#theme-toggle");
  const preference = matchMedia("(prefers-color-scheme: dark)");
  let userChoice = false;
  try {
    userChoice = ["light", "dark"].includes(
      localStorage.getItem("theme") || "",
    );
  } catch {}
  function syncThemeLabel() {
    const dark = document.documentElement.classList.contains("dark");
    const label = `Switch to ${dark ? "light" : "dark"} theme`;
    theme?.setAttribute("aria-label", label);
    theme?.setAttribute("title", label);
  }
  theme?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    userChoice = true;
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {}
    syncThemeLabel();
  });
  preference.addEventListener("change", (e) => {
    if (!userChoice) {
      document.documentElement.classList.toggle("dark", e.matches);
      syncThemeLabel();
    }
  });
  syncThemeLabel();
  const details = document.querySelector<HTMLDetailsElement>("#menu-details")!;
  const toggle = document.querySelector<HTMLElement>("#menu-toggle")!;
  function closeMenu(restoreFocus = false) {
    if (!details.open) return;
    details.open = false;
    if (restoreFocus) toggle.focus();
  }
  details.addEventListener("toggle", () => {
    toggle.setAttribute("aria-expanded", String(details.open));
    toggle.setAttribute(
      "aria-label",
      details.open ? "Close navigation" : "Open navigation",
    );
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && details.open) {
      e.preventDefault();
      closeMenu(true);
    }
  });
  document.addEventListener("click", (e) => {
    if (e.target instanceof Node && !details.contains(e.target)) closeMenu();
  });
  const desktop = matchMedia("(min-width: 801px)");
  desktop.addEventListener("change", (e) => {
    if (e.matches) closeMenu();
  });
</script>
