---
import { siteSettings } from "../../config/siteSettings";

interface PageSpeedResult {
  performance: number;
  fcp?: string | null;
  lcp?: string | null;
  cls?: string | null;
  tbt?: string | null;
  speedIndex?: string | null;
}

interface Props {
  collapsed?: boolean;
  report: {
    source?: string;
    testedUrl?: string;
    measuredAt?: string;
    mobile?: PageSpeedResult;
    desktop?: PageSpeedResult;
    mobileError?: string;
    desktopError?: string;
  };
}

const { report, collapsed = false } = Astro.props;
const Report = collapsed ? "details" : "section";
const allDevices = [
  {
    label: "Mobile",
    result: report.mobile,
  },
  {
    label: "Desktop",
    result: report.desktop,
  },
].filter((device): device is { label: string; result: PageSpeedResult } =>
  Boolean(device.result && device.result.performance >= 70),
);
const devices = siteSettings.showDesktopPageSpeedOnly
  ? allDevices.filter((device) => device.label === "Desktop")
  : allDevices;
const metrics = [
  { key: "fcp", label: "First Contentful Paint", thresholds: [1.8, 3] },
  { key: "si", label: "Speed Index", thresholds: [3.4, 5.8] },
  { key: "lcp", label: "Largest Contentful Paint", thresholds: [2.5, 4] },
  { key: "tbt", label: "Total Blocking Time", thresholds: [200, 600] },
  { key: "cls", label: "Cumulative Layout Shift", thresholds: [0.1, 0.25] },
] as const;
const scoreLevel = (score: number) =>
  score >= 90 ? "good" : score >= 50 ? "needs-improvement" : "poor";
const metricLevel = (key: string, value: string) => {
  const parsed = Number.parseFloat(value.replace(/,/g, ""));
  if (!Number.isFinite(parsed)) return "unrated";
  const definition = metrics.find((metric) => metric.key === key);
  if (!definition) return "unrated";
  return parsed <= definition.thresholds[0]
    ? "good"
    : parsed <= definition.thresholds[1]
      ? "needs-improvement"
      : "poor";
};
---

{devices.length > 0 && (
  <Report
    class:list={["pagespeed-report", collapsed && "plain-card"]}
    aria-label="Google PageSpeed Insights results"
  >
    {collapsed && <summary>Google PageSpeed Insights results</summary>}
    <header class="pagespeed-header">
      <div>
        <span class="eyebrow">
          {report.source || "Google PageSpeed Insights"}
        </span>
        <h3 class="pagespeed-report__title portfolio__heading portfolio__heading--subsection">Performance report</h3>
      </div>
    </header>
    {devices.map(({ label, result }) => (
      <section class="pagespeed-device" aria-label={`${label} performance`}>
        <h4 class="pagespeed-report__device-title portfolio__heading">{label}</h4>
        <div
          class="pagespeed-report__summary-row"
          tabindex="0"
          role="group"
          aria-label={`${label} score and metrics`}
        >
          <div class="pagespeed-score-row">
            <div
              class:list={["pagespeed-score", scoreLevel(result.performance)]}
              aria-label={`Performance score ${result.performance} out of 100`}
            >
              <svg
                class="pagespeed-report__dial"
                viewBox="0 0 100 100"
                aria-hidden="true"
              >
                <circle
                  class="pagespeed-score-track"
                  cx="50"
                  cy="50"
                  r="42"
                  pathLength="100"
                />
                <circle
                  class="pagespeed-score-value"
                  cx="50"
                  cy="50"
                  r="42"
                  pathLength="100"
                  stroke-dasharray={`${Math.max(0, Math.min(100, result.performance))} 100`}
                />
              </svg>
              <span class="pagespeed-report__number">{result.performance}</span>
            </div>
            <span
              class:list={[
                "pagespeed-score-label",
                scoreLevel(result.performance),
              ]}
            >
              Performance
            </span>
          </div>
          <dl class="pagespeed-metrics">
            {metrics.map((metric) => {
              const value =
                metric.key === "si" ? result.speedIndex : result[metric.key];
              return value != null && value !== "" ? (
                <div
                  class:list={[
                    "pagespeed-metric",
                    metricLevel(metric.key, value),
                  ]}
                >
                  <dt class="pagespeed-report__metric-name">{metric.label}</dt>
                  <dd class="pagespeed-report__metric-value">{value}</dd>
                </div>
              ) : null;
            })}
          </dl>
        </div>
      </section>
    ))}
    <footer class="pagespeed-footer">
      <span>Scores can change over time.</span>
    </footer>
  </Report>
)}
