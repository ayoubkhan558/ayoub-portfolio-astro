---
interface Props {
  label: string;
  items: string[];
}
const { label, items } = Astro.props;
---

<div
  class="text-rotator"
  data-text-rotator
  role="group"
  aria-label={label}
  tabindex="0"
>
  <div class="text-rotator__line">
    <h4 class="text-rotator__label portfolio__heading">{label}</h4>
    <ul class="rotator-items" aria-label={label}>
      {items.map((item, i) => (
        <li class:list={["rotator-items__item", i === 0 && "is-current"]}>
          <p class="rotator-items__description portfolio__paragraph">
            <span class="rotator-items__accessible-text">{item}</span>
            <span aria-hidden="true">
              {item.split(/\s+/).map((word, index) => (
                <Fragment>
                  {index > 0 && " "}
                  <span class="rotator-items__word">
                    {Array.from(word, (letter) => (
                      <span class="rotator-items__letter">{letter}</span>
                    ))}
                  </span>
                </Fragment>
              ))}
            </span>
            <span class="rotator-items__flower" aria-hidden="true">
              ✽
            </span>
          </p>
        </li>
      ))}
    </ul>
  </div>
</div>
<script>
  document
    .querySelectorAll<HTMLElement>("[data-text-rotator]")
    .forEach((root) => {
      const items = Array.from(
        root.querySelectorAll<HTMLElement>(".rotator-items li"),
      );
      const reduced = matchMedia("(prefers-reduced-motion: reduce)");
      let index = 0,
        inView = false,
        timer: ReturnType<typeof setInterval> | undefined;
      root.dataset.ready = "true";
      let transition: Animation[] = [];
      let rotating = false;

      async function animateLetters(
        item: HTMLElement,
        frames: Keyframe[],
        duration: number,
      ) {
        if (reduced.matches) return;
        const letters = [...item.querySelectorAll(".rotator-items__letter")];
        // Keep long phrases moving as quickly as short ones.
        const stagger = Math.min(9, 220 / Math.max(1, letters.length - 1));
        transition = letters.map((letter, i) =>
          letter.animate(frames, {
            duration,
            delay: i * stagger,
            easing: "ease-out",
            fill: "both",
          }),
        );
        await Promise.all(
          transition.map((animation) => animation.finished.catch(() => {})),
        );
      }

      async function showNext() {
        if (rotating || items.length < 2) return;
        rotating = true;
        const previous = items[index];
        await animateLetters(
          previous,
          [
            { opacity: 1, transform: "translateY(0)", filter: "blur(0)" },
            {
              opacity: 0,
              transform: "translateY(-0.35em)",
              filter: "blur(5px)",
            },
          ],
          170,
        );
        previous.classList.remove("is-current");
        transition.forEach((animation) => animation.cancel());

        index = (index + 1) % items.length;
        const current = items[index];
        current.classList.add("is-current");
        await animateLetters(
          current,
          [
            {
              opacity: 0,
              transform: "translateY(0.35em)",
              filter: "blur(5px)",
            },
            { opacity: 1, transform: "translateY(0)", filter: "blur(0)" },
          ],
          260,
        );
        transition.forEach((animation) => animation.cancel());
        transition = [];
        rotating = false;
      }
      function sync() {
        clearInterval(timer);
        if (
          !reduced.matches &&
          inView &&
          !document.hidden &&
          !root.matches(":hover, :focus-within")
        )
          timer = setInterval(showNext, 4000);
      }
      ["mouseenter", "mouseleave", "focusin"].forEach((event) =>
        root.addEventListener(event, sync),
      );
      root.addEventListener("focusout", () => setTimeout(sync, 0));
      document.addEventListener("visibilitychange", sync);
      reduced.addEventListener("change", () => {
        if (reduced.matches)
          transition.forEach((animation) => animation.cancel());
        sync();
      });
      new IntersectionObserver((entries) => {
        inView = entries[0].isIntersecting;
        sync();
      }).observe(root);
      sync();
    });
</script>
