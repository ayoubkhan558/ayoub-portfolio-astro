---
import { Volume2, VolumeX } from "lucide-react";
---

<button type="button" class="pointer-feedback__toggle" aria-label="Hover sound" aria-pressed="true" title="Mute hover sound" hidden>
  <Volume2 className="pointer-feedback__icon--on" size={20} aria-hidden="true" />
  <VolumeX className="pointer-feedback__icon--off" size={20} aria-hidden="true" />
</button>
<span class="pointer-feedback__halo" aria-hidden="true" hidden></span>
<script>
  const control = document.querySelector<HTMLButtonElement>(".pointer-feedback__toggle");
  let soundOn = true;
  const halo = document.querySelector<HTMLElement>(".pointer-feedback__halo");
  const sounds = {
    tick: { from: 850, to: 640, length: 0.045, type: "sine" },
    tap: { from: 280, to: 130, length: 0.065, type: "triangle" },
    pop: { from: 460, to: 210, length: 0.085, type: "sine" },
    chime: { from: 1040, to: 780, length: 0.13, type: "sine" },
  } as const;
  const finePointer = matchMedia("(hover: hover) and (pointer: fine)");
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  const interactive = "a[href], button:enabled, summary, [role=button]";
  let audio: AudioContext | undefined;
  let lastPlayed = 0;
  let hovered: Element | null = null;
  let frame = 0;

  function play(kind: keyof typeof sounds) {
    const sound = sounds[kind];
    if (!soundOn || !audio || performance.now() - lastPlayed < 120) return;
    if (audio.state !== "running") return;
    lastPlayed = performance.now();
    const start = audio.currentTime;
    const oscillator = audio.createOscillator();
    const gain = audio.createGain();
    oscillator.type = sound.type;
    oscillator.frequency.setValueAtTime(sound.from, start);
    oscillator.frequency.exponentialRampToValueAtTime(sound.to, start + sound.length);
    gain.gain.setValueAtTime(0.001, start);
    gain.gain.exponentialRampToValueAtTime(0.045, start + 0.008);
    gain.gain.exponentialRampToValueAtTime(0.001, start + sound.length);
    oscillator.connect(gain).connect(audio.destination);
    oscillator.start(start);
    oscillator.stop(start + sound.length);
  }

  if (control && window.AudioContext) {
    control.hidden = false;
    try { soundOn = localStorage.getItem("portfolio-hover-sound") !== "off"; } catch {}
    function syncToggle() {
      if (!control) return;
      control.title = soundOn ? "Mute hover sound" : "Enable hover sound";
      control.setAttribute("aria-pressed", String(soundOn));
    }
    async function enableSound() {
      if (!soundOn || !finePointer.matches) return;
      try {
        audio ??= new AudioContext();
        if (audio.state !== "running") await audio.resume();
      } catch {}
    }
    syncToggle();
    control.addEventListener("click", async () => {
      soundOn = !soundOn;
      syncToggle();
      try { localStorage.setItem("portfolio-hover-sound", soundOn ? "on" : "off"); } catch {}
      await enableSound();
      play("tap");
    });
    document.addEventListener("pointerdown", enableSound);
    document.addEventListener("keydown", enableSound);
  }

  document.addEventListener("pointermove", (event) => {
    const element = event.target instanceof Element ? event.target : null;
    const controlTarget = element?.closest(interactive);
    const card = element?.closest(".selected-card, .case-card__link, .project-card, .testimonial-card, .review-journal__entry");
    const target = (element?.closest("dialog") ? controlTarget : card ?? controlTarget) ?? null;
    const next = finePointer.matches && event.pointerType === "mouse" ? target : null;
    if (next && next !== hovered) {
      play(next === card ? "pop" : next.matches("summary, [data-slot^=carousel-]") ? "chime" : next.matches("button, .button, [role=button]") ? "tap" : "tick");
    }
    hovered = next;
    if (!halo) return;
    cancelAnimationFrame(frame);
    halo.hidden = !next || reducedMotion.matches;
    if (!halo.hidden) {
      frame = requestAnimationFrame(() => {
        halo.style.translate = `${event.clientX}px ${event.clientY}px`;
      });
    }
  });
  function clearHover() {
    hovered = null;
    if (halo) halo.hidden = true;
  }
  document.documentElement.addEventListener("pointerleave", clearHover);
  window.addEventListener("blur", clearHover);
  reducedMotion.addEventListener("change", clearHover);
  finePointer.addEventListener("change", clearHover);
</script>
