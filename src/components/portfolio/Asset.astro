---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

import { getAsset, initials } from "../../lib/assets";
interface Props extends Omit<HTMLAttributes<"img">, "src" | "alt"> {
  src?: string | null;
  fallback?: string;
  alt?: string;
  eager?: boolean;
  imageClassOnly?: boolean;
  optimizeWidths?: [number, ...number[]];
}
const {
  src,
  fallback,
  alt = "",
  class: className = "",
  eager = false,
  imageClassOnly = false,
  optimizeWidths,
  sizes,
  ...rest
} = Astro.props;
const optimizable = import.meta.glob<{ default: ImageMetadata }>([
  "/public/ayoub-about-v4.jpg",
  "/public/client/*.png",
  "/public/case-study/*-thumbnail.{jpg,webp}",
  "/public/projects/**/project-ss-{xgrid,alkira,chkk,pagano-law,king-sr-real-estate-rk,weinberger-aesthetics}.jpg",
]);
const variant = optimizeWidths && src ? await optimizable[`/public${src}`]?.() : undefined;
const asset = getAsset(src) ?? (fallback ? getAsset(fallback) : null);
const classes = imageClassOnly ? className : ["portfolio__image", className].filter(Boolean).join(" ");
---

{variant && optimizeWidths ? (
  <Image
    src={variant.default}
    alt={alt}
    class={classes}
    width={Math.min(optimizeWidths[0], variant.default.width)}
    widths={[...new Set(optimizeWidths.map(width => Math.min(width, variant.default.width)))]}
    sizes={sizes}
    format="webp"
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={eager ? "high" : "auto"}
    {...rest}
  />
) : asset ? (
  <img
    src={asset.src}
    width={asset.width}
    height={asset.height}
    alt={alt}
    class={classes}
    sizes={sizes}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={eager ? "high" : "auto"}
    {...rest}
  />
) : (
  <div
    class:list={["asset-fallback", className]}
    role="img"
    aria-label={`${alt} — preview not supplied`}
  >
    <>
      <span class="asset-fallback__label">{initials(alt)}</span>
      <small class="asset-fallback__note portfolio__note">
        Project preview unavailable
      </small>
    </>
  </div>
)}
