---
import type { HTMLAttributes } from "astro/types";

import { getAsset, initials } from "../../lib/assets";
interface Props extends Omit<HTMLAttributes<"img">, "src" | "alt"> {
  src?: string | null;
  fallback?: string;
  alt?: string;
  eager?: boolean;
  imageClassOnly?: boolean;
}
const {
  src,
  fallback,
  alt = "",
  class: className = "",
  eager = false,
  imageClassOnly = false,
  ...rest
} = Astro.props;
const asset = getAsset(src) ?? (fallback ? getAsset(fallback) : null);
---

{asset ? (
  <img
    src={asset.src}
    width={asset.width}
    height={asset.height}
    alt={alt}
    class={
      imageClassOnly
        ? className
        : ["portfolio__image", className].filter(Boolean).join(" ")
    }
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={eager ? "high" : "auto"}
    {...rest}
  />
) : (
  <div
    class:list={["asset-fallback", className]}
    role="img"
    aria-label={`${alt} — preview not supplied`}
  >
    <>
      <span class="asset-fallback__label">{initials(alt)}</span>
      <small class="asset-fallback__note portfolio__note">
        Project preview unavailable
      </small>
    </>
  </div>
)}
