---
import type { HTMLAttributes } from "astro/types";

import { getAsset, initials } from "../../lib/assets";
interface Props extends Omit<HTMLAttributes<"img">, "src" | "alt"> {
  src?: string | null;
  alt?: string;
  eager?: boolean;
}
const {
  src,
  alt = "",
  class: className = "",
  eager = false,
  ...rest
} = Astro.props;
const asset = getAsset(src);
---

{asset ? (
  <img
    src={asset.src}
    width={asset.width}
    height={asset.height}
    alt={alt}
    class={className}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={eager ? "high" : "auto"}
    {...rest}
  />
) : (
  <div
    class:list={["asset-fallback", className]}
    role="img"
    aria-label={`${alt} — preview not supplied`}
  >
    <>
      <span>{initials(alt)}</span>
      <small>Project preview unavailable</small>
    </>
  </div>
)}
