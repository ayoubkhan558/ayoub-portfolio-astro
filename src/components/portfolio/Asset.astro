---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

import { getAsset, initials } from "../../lib/assets";
interface Props extends Omit<HTMLAttributes<"img">, "src" | "alt" | "width"> {
  src?: string | null;
  fallback?: string;
  alt?: string;
  eager?: boolean;
  imageClassOnly?: boolean;
  /** Requested output width in CSS pixels. Raster sources also use it for optimization. */
  width?: number;
  quality?: number;
  optimizeWidths?: [number, ...number[]];
}
const {
  src,
  fallback,
  alt = "",
  class: className = "",
  eager = false,
  imageClassOnly = false,
  optimizeWidths,
  width,
  quality,
  sizes,
  ...rest
} = Astro.props;
// Astro imports originals and generates size variants during the build.
const optimizable = import.meta.glob<{ default: ImageMetadata }>([
  "/public/ayoub-about-v4.jpg",
  "/public/client/*.png",
  "/public/comapnies/*.png",
  "/public/case-study/*-thumbnail.{jpg,webp}",
  "/public/projects/**/project-ss-{xgrid,alkira,chkk,pagano-law,king-sr-real-estate-rk,weinberger-aesthetics}.jpg",
]);
const requestedWidths = optimizeWidths ?? (width ? [width] : undefined);
const variant = requestedWidths && src ? await optimizable[`/public${src}`]?.() : undefined;
const asset = getAsset(src) ?? (fallback ? getAsset(fallback) : null);
const displayWidth = width && asset?.width ? Math.min(width, asset.width) : width ?? asset?.width;
const displayHeight = displayWidth && asset?.width && asset.height
  ? Math.round(asset.height * displayWidth / asset.width)
  : asset?.height;
const classes = imageClassOnly ? className : ["portfolio__image", className].filter(Boolean).join(" ");
---

{variant && requestedWidths ? (
  <Image
    src={variant.default}
    alt={alt}
    class={classes}
    width={Math.min(width ?? requestedWidths[0], variant.default.width)}
    widths={[...new Set(requestedWidths.map(width => Math.min(width, variant.default.width)))]}
    sizes={sizes}
    format="webp"
    quality={quality}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={eager ? "high" : "auto"}
    {...rest}
  />
) : asset ? (
  <img
    src={asset.src}
    width={displayWidth}
    height={displayHeight}
    alt={alt}
    class={classes}
    sizes={sizes}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={eager ? "high" : "auto"}
    {...rest}
  />
) : (
  <div
    class:list={["asset-fallback", className]}
    role="img"
    aria-label={`${alt} — preview not supplied`}
  >
    <>
      <span class="asset-fallback__label">{initials(alt)}</span>
      <small class="asset-fallback__note portfolio__note">
        Project preview unavailable
      </small>
    </>
  </div>
)}
