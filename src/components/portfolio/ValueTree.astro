---
// Recursive, semantic rendering for additional structured details. No content is injected as HTML.
import Asset from "./Asset.astro";
const { value, label } = Astro.props;
const human = (key: string) =>
  key
    .replace(/([a-z])([A-Z])/g, "$1 $2")
    .replaceAll("_", " ")
    .replace(/^./, (c) => c.toUpperCase());
const isImage = (v: unknown) =>
  typeof v === "string" && /\.(png|webp|jpe?g|svg)(\?.*)?$/i.test(v);
---

{value != null && (
  <div class="value-tree">
    {label && <h3>{human(label)}</h3>}
    {Array.isArray(value) ? (
      <div class="value-list">
        {value.map((v) => (
          <Astro.self value={v} />
        ))}
      </div>
    ) : typeof value === "object" ? (
      <div class="value-object">
        {Object.entries(value)
          .filter(([, v]) => v != null && v !== "")
          .map(([k, v]) => (
            <Astro.self label={k} value={v} />
          ))}
      </div>
    ) : isImage(value) ? (
      <Asset src={value} alt={label || "Project detail"} class="detail-image" />
    ) : typeof value === "string" &&
      /^(https?:|mailto:|tel:|\/)/.test(value) ? (
      <a class="text-link" href={value}>
        {value}
      </a>
    ) : (
      <p>{String(value)}</p>
    )}
  </div>
)}
