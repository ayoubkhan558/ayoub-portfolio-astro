---
const wordmark = "MAYOUB.DEV";
---

<div class="portfolio-footer-wordmark" role="img" aria-label={wordmark}>
  {Array.from(wordmark, (letter) => (
    <span class="portfolio-footer-wordmark__letter" aria-hidden="true">
      {letter}
    </span>
  ))}
</div>

<script>
  import { createSpring } from "../../lib/pointerSpring";

  const motion = matchMedia(
    "(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)",
  );

  for (const wordmark of document.querySelectorAll<HTMLElement>(
    ".portfolio-footer-wordmark",
  )) {
    const letters = [
      ...wordmark.querySelectorAll<HTMLElement>(
        ".portfolio-footer-wordmark__letter",
      ),
    ];
    const radius = 150;
    let target = 0;
    let pointer = createSpring();
    let strength = createSpring();
    let active = false;
    let frame = 0;
    let centers: number[] = [];

    function render() {
      const x = pointer.step(target);
      const blend = strength.step(active ? 1 : 0);
      const amount = Math.max(0, Math.min(1, blend));
      letters.forEach((letter, index) => {
        const distance = Math.min(1, Math.abs(x - centers[index]) / radius);
        const weight = 100 + (800 * (1 + Math.cos(distance * Math.PI))) / 2;
        letter.style.fontVariationSettings = `"wght" ${100 + (weight - 100) * amount}`;
      });

      frame =
        x !== target || blend !== (active ? 1 : 0)
          ? requestAnimationFrame(render)
          : 0;
    }

    wordmark.addEventListener("pointermove", (event) => {
      if (!motion.matches || event.pointerType === "touch") return;
      target = event.clientX;
      if (!active) {
        // Measure once before animating font weights to avoid per-frame layout reads.
        centers = letters.map((letter) => {
          const rect = letter.getBoundingClientRect();
          return rect.left + rect.width / 2;
        });
        if (!frame) pointer = createSpring(target);
      }
      active = true;
      if (!frame) frame = requestAnimationFrame(render);
    });

    wordmark.addEventListener("pointerleave", () => {
      if (!active) return;
      active = false;
      if (!frame) frame = requestAnimationFrame(render);
    });

    motion.addEventListener("change", () => {
      active = false;
      cancelAnimationFrame(frame);
      frame = 0;
      strength = createSpring();
      letters.forEach((letter) =>
        letter.style.removeProperty("font-variation-settings"),
      );
    });
  }
</script>
