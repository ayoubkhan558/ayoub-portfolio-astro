---
import p from "../../data/portfolio.json";
---

<div class="process-grid">
  {p.process.map((s, i) => (
    <article class="process-grid__step">
      <>
        <span class="process-grid__number">{String(i + 1).padStart(2, "0")}</span>
        <h3 class="portfolio__heading portfolio__heading--subsection">{s.title}</h3>
        <p class="process-grid__description portfolio__paragraph">{s.description}</p>
        <div class="metric-row">
          {s.metrics.map((m) => (
            <span>
              <small class="metric-row__note portfolio__note">{m.label}</small>
              <b class="metric-row__value">{m.value}</b>
            </span>
          ))}
        </div>
      </>
    </article>
  ))}
</div>
