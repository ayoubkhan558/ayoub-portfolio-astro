---
import p from "../../data/portfolio.json";
---

<div class="process-grid">
  {p.process.map((s, i) => (
    <article>
      <>
        <span class="step-number">{String(i + 1).padStart(2, "0")}</span>
        <h3>{s.title}</h3>
        <p>{s.description}</p>
        <div class="metric-row">
          {s.metrics.map((m) => (
            <span>
              <small>{m.label}</small>
              <b>{m.value}</b>
            </span>
          ))}
        </div>
      </>
    </article>
  ))}
</div>
