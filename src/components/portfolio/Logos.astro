---
import Asset from "./Asset.astro";
import p from "../../data/portfolio.json";
import { projectLogos } from "../../data/projectLogos";

interface Props {
  projectsOnly?: boolean;
  label?: string;
}

const { projectsOnly = false, label } = Astro.props;
const clients = projectsOnly ? projectLogos : [...p.clients.filter(client => client.showInLogos), ...projectLogos];
---

<div class="logo-strip" role={label ? "group" : undefined} aria-label={label}>
  {clients.map((c) => {
    const darkLogo = ("logoDark" in c && c.logoDark) || c.logo;
    const LogoItem = c.website ? "a" : "span";
    const link = c.website
      ? {
          href: c.website,
          target: "_blank",
          rel: "noopener noreferrer",
          "aria-label": "Visit " + c.name + " website",
        }
      : {};

    return (
      <LogoItem class:list={["logo-strip__item", c.website && "portfolio__link"]} {...link}>
        {"whiteTile" in c && c.whiteTile ? (
          <Asset src={c.logo} width={120} optimizeWidths={[120, 240]} sizes="(min-width: 560px) 120px, 95px" alt={c.name} class="client-logo client-logo--white-tile" />
        ) : (
          <>
            <Asset src={c.logo} optimizeWidths={[192, 384]} sizes="(min-width: 560px) 120px, 95px" alt={c.name} class="client-logo light-logo" />
            <Asset
              src={darkLogo}
              optimizeWidths={[192, 384]}
              sizes="(min-width: 560px) 120px, 95px"
              alt={c.name}
              class="client-logo dark-logo"
            />
          </>
        )}
      </LogoItem>
    );
  })}
</div>
