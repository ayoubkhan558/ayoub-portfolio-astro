---
import p from "../../data/portfolio.json";
import { FAQ } from "../blocks/faq";
---

<div class="faq-enhanced">
  <FAQ items={p.faqs} client:load />
</div>
<noscript>
  <style>
    .faq-enhanced {
      display: none;
    }
  </style>
  <div class="faq-list">
    {p.faqs.map((f) => (
      <details class="faq-list__item" name="portfolio-faq">
        <summary class="faq-list__question">{f.question}</summary>
        <p class="faq-list__answer portfolio__paragraph">{f.answer}</p>
      </details>
    ))}
  </div>
</noscript>
