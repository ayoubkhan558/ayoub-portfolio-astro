---
import Asset from "./Asset.astro";
import ExternalArrow from "./ExternalArrow.astro";
import PageSpeedReport from "./PageSpeedReport.astro";
import ValueTree from "./ValueTree.astro";
import { getAsset } from "../../lib/assets";
import { toolCatalog } from "../../data/toolCatalog";
import {
  getProjectTitle,
  getProjectDescription,
  getProjectMeta,
  normalizeHttpLink,
  projectPlatformFilters,
  projectMatchesPlatform,
} from "../../data/projectsArchive";
import type archive from "../../data/projectsArchive.json";
interface Props {
  project: (typeof archive.projects)[number];
  index: number;
  featured?: boolean;
}
const { project: p, index, featured = false } = Astro.props;
const title = getProjectTitle(p);
const panelId = `project-${index}`;
const description = getProjectDescription(p);
const isDomainExpired = p.projectStatus === "Offline (Domain Expired)";
const websiteHref = normalizeHttpLink(p.websiteUrl);
const copyHref = !websiteHref?.toLowerCase().includes("figma.com")
  ? websiteHref
  : undefined;
const href = !isDomainExpired ? copyHref : undefined;
const keys = projectPlatformFilters
  .filter((filter) => projectMatchesPlatform(p, filter.value))
  .map((f) => f.value)
  .join(" ");
const search = [
  title,
  p.description,
  p.categoryNiche,
  p.platformFrameworkBuilder,
  p.projectType,
  p.company,
  p.notes,
  p.myRole,
]
  .filter(Boolean)
  .join(" ")
  .toLowerCase();
const details = Object.fromEntries(
  Object.entries(p).filter(
    ([k, v]) =>
      ![
        "websiteName",
        "description",
        "platformFrameworkBuilder",
        "screenshot",
        "projectStatus",
        "pageSpeed",
        "figmaLink",
        "rating",
        ...(!href ? ["websiteUrl"] : []),
        "notes",
      ].includes(k) &&
      !(typeof v === "string" && v.toLowerCase().includes("figma.com")) &&
      v != null &&
      v !== "",
  ),
);
const stack = (p.platformFrameworkBuilder || "Custom web build")
  .split(
    /[,/]| (?=(?:Next|React|Tailwind|Vue|Bootstrap|WordPress|Elementor|Shopify|Webflow|Wix|Bricks|Laravel|HTML|CSS|Scss|jQuery|PHP)\b)/i,
  )
  .flatMap<{ name: string; logo: string | null }>((part) => {
    const label = part.toLowerCase().replace(/[^a-z0-9]/g, "");
    const matches = Object.entries(toolCatalog)
      .filter(([key, tool]) => {
        const aliases: Record<string, string[]> = {
          react: ["reactjs"],
          tailwind: ["tailwindcss"],
          wordpress: ["wordperss"],
        };
        const names = [key, tool.name, ...(aliases[key] || [])].map((name) =>
          name.toLowerCase().replace(/[^a-z0-9]/g, ""),
        );
        return names.some((name) => label.includes(name));
      })
      .map(([, tool]) => tool);
    return matches.length ? matches : [{ name: part.trim(), logo: null }];
  })
  .filter((tool) => tool.name);
---

<article
  class={featured ? "selected-card" : "project-card"}
  data-project-drawer-card
  data-search={search}
  data-platform={keys}
  data-status={p.projectStatus || ""}
  data-project-title={title}
  data-project-rating={p.rating ?? 0}
  data-project-category={getProjectMeta(p).join(", ")}
  data-project-website={copyHref || ""}
>
  {featured ? <slot /> : <>
  <div class="project-media">
    <Asset
      src={p.screenshot}
      fallback="/social/ayoub-portfolio-thumbnail-projects.jpg"
      alt={`${title} website preview`}
      class="project-preview"
    />
    <span
      class:list={[
        "project-status",
        p.projectStatus === "Live" ? "is-live" : "is-legacy",
      ]}
    >
      {p.projectStatus || "Status not recorded"}
    </span>
    {p.company && <span class="delivery-badge">Delivered at {p.company}</span>}
  </div>
  <div class="project-body">
    <h2>{title}</h2>
    <p>{description}</p>
    <div class="tags">
      {stack.map((tool) => {
        const logo = getAsset(tool.logo);
        return logo ? (
          <span class="project-stack-logo" title={tool.name}>
            <img src={logo.src} alt={tool.name} loading="lazy" decoding="async" />
          </span>
        ) : (
          <span>{tool.name}</span>
        );
      })}
    </div>
    <div class="project-links card-link-row">
      <button
        type="button"
        class="button outline project-open card-action"
        data-project-open={panelId}
        aria-haspopup="dialog"
        aria-controls={panelId}
      >
        Project details <ExternalArrow />
      </button>
      {isDomainExpired && (
        <span class="text-link project-domain-expired">Domain expired</span>
      )}
      {!isDomainExpired && href && (
        <a
          class="text-link"
          href={href}
          target="_blank"
          rel="noopener noreferrer"
        >
          Website <ExternalArrow />
        </a>
      )}
    </div>
    <noscript>
      <details>
        <summary>Project details</summary>
        <ValueTree value={details} />
      </details>
    </noscript>
  </div>
  </>}
  <dialog
    class="project-drawer"
    id={panelId}
    aria-labelledby={`${panelId}-title`}
  >
    <div class="drawer-header">
      <span class="eyebrow">Project details</span>
      <button
        type="button"
        class="icon-button drawer-close"
        aria-label="Close project details"
      >
        <svg
          aria-hidden="true"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        >
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
    <div class="drawer-content">
      <Asset
        src={p.screenshot}
        fallback="/social/ayoub-portfolio-thumbnail-projects.jpg"
        alt={`${title} website preview`}
        class="drawer-image"
      />
      <div class="tags spaced">
        <span>{p.projectStatus || "Status not recorded"}</span>
        {stack.map((tool) => {
          const logo = getAsset(tool.logo);
          return logo ? (
            <span class="project-stack-logo" title={tool.name}>
              <img src={logo.src} alt={tool.name} loading="lazy" decoding="async" />
            </span>
          ) : (
            <span>{tool.name}</span>
          );
        })}
      </div>
      <h2 id={`${panelId}-title`}>{title}</h2>
      <p>{description}</p>
      <ValueTree value={details} />
      {p.pageSpeed && <PageSpeedReport report={p.pageSpeed} />}
      <div class="actions">
        {href && (
          <a
            class="button"
            href={href}
            target="_blank"
            rel="noopener noreferrer"
          >
            Visit website <ExternalArrow />
          </a>
        )}
      </div>
    </div>
  </dialog>
</article>

<script>
  let opener: HTMLElement | null = null;
  for (const card of document.querySelectorAll<HTMLElement>("[data-project-drawer-card]")) {
    const dialog = card.querySelector<HTMLDialogElement>("dialog")!;
    const button = card.querySelector<HTMLButtonElement>("[data-project-open]")!;
    const open = () => {
      if (dialog.open) return;
      opener = button;
      dialog.showModal();
      document.body.classList.add("drawer-open");
    };
    card.addEventListener("click", (event) => {
      if (
        !(event.target instanceof Element) ||
        dialog.contains(event.target) ||
        event.target.closest("a,details")
      )
        return;
      open();
    });
    button.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        open();
      }
    });
    dialog
      .querySelector(".drawer-close")
      ?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) {
        const rect = dialog.getBoundingClientRect();
        if (
          e.clientX < rect.left ||
          e.clientX > rect.right ||
          e.clientY < rect.top ||
          e.clientY > rect.bottom
        )
          dialog.close();
      }
    });
    dialog.addEventListener("close", () => {
      document.body.classList.remove("drawer-open");
      opener?.focus({ preventScroll: true });
    });
  }
</script>
