---
import p from "../../data/portfolio.json";
const {
  title = "Got a project? Let's talk.",
  text = "Tell me what you're building.",
  button = p.hero.primaryCta,
} = Astro.props;
---

<section class="cta-panel wrap">
  <span class="eyebrow">Work together</span>
  <h2>{title}</h2>
  <p>{text}</p>
  <div class="actions">
    <a class="button" href="/contact/">
      {button} <span aria-hidden="true">↗</span>
    </a>
    <a class="text-link" href={`mailto:${p.profile.email}`}>
      {p.profile.email}
    </a>
  </div>
  <p class="offer">{p.offer}</p>
</section>
