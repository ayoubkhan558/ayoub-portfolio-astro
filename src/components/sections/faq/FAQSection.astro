---
import FAQList from "../shared/FAQList.astro";
import p from "../../../data/portfolio.json";
const topics = [
  { title: "Services and pricing", items: [p.faqs[1], p.faqs[2], p.faqs[5]] },
  { title: "Timelines and working together", items: [p.faqs[0], p.faqs[3]] },
  { title: "After launch", items: [p.faqs[4]] },
];
---

<section class="section-spacing section-spacing--opening">
  <div class="container">
    {topics.map((topic, index) => (
      <section class="faq-topics__group">
        <h2 class="portfolio__heading portfolio__heading--section">{topic.title}</h2>
        <FAQList items={topic.items} name={`faq-topic-${index}`} class="faq-list" />
      </section>
    ))}
  </div>
</section>
