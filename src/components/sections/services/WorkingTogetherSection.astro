---
const whyWork = [
  "Scope agreed before work starts",
  "Updates without being asked",
  "Deadlines that hold",
  "Code the next dev can read",
  "Mobile and performance by default",
  "Feedback rounds, not big reveals",
  "Problems flagged early, not at launch",
  "Clean handoff every time",
  "You own it when we're done",
];
---

<section class="services-working-together-section section wrap">
  <div class="section-heading">
    <div>
      <span class="eyebrow">Working together</span>
      <h2>Clear scope. Useful milestones.</h2>
    </div>
  </div>
  <div class="three-grid">
    {whyWork.map((reason) => (
      <article class="plain-card">
        <h3>{reason}</h3>
      </article>
    ))}
  </div>
</section>
