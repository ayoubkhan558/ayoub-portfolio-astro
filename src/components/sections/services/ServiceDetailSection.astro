---
import ExternalArrow from "../../portfolio/ExternalArrow.astro";
import type { ServiceNiche } from "../../../data/serviceNiches";
interface Props {
  service: ServiceNiche;
}
const { service } = Astro.props;
---

<section class="service-detail-content-section section-spacing">
  <div class="container">
    <div class="service-detail-content-section__topics">
      {service.sections.map((section) => (
        <article class="service-detail-content-section__topic">
          <h2 class="service-detail-content-section__title portfolio__heading portfolio__heading--section">{section.title}</h2>
          {section.paragraphs.map((text) => (
            <p class="portfolio__paragraph">{text}</p>
          ))}
          {section.bullets && (
            <ul class="check-list">
              {section.bullets.map((text) => (
                <li class="check-list__item">{text}</li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>
    {service.relatedCases.length > 0 && (
      <>
        <h2 class="service-detail-content-section__subheading portfolio__heading portfolio__heading--section">
          Related case studies
        </h2>
        {service.relatedNote && <p class="portfolio__paragraph">{service.relatedNote}</p>}
        <div class="link-list">
          {service.relatedCases.map((c) => (
            <a class="text-link portfolio__link" href={c.href}>
              {c.label} <ExternalArrow />
            </a>
          ))}
        </div>
      </>
    )}
  </div>
</section>
