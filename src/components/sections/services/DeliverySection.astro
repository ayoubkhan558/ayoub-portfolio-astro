---
import TextRotator from "../../portfolio/TextRotator.astro";
import { problemsSolved } from "../home/problems";

const outcomes = [
  "A clearer homepage that explains the offer in seconds",
  "Stronger calls to action and a simpler inquiry path",
  "Pages structured around buyer questions, objections, and next steps",
  "A faster mobile experience that protects trust before the first click",
  "Reusable sections for future campaigns, services, and landing pages",
  "A website that feels more credible against stronger competitors",
  "Clean implementation that your team or next developer can maintain",
  "CMS support only where editing control is genuinely useful",
];
---

<section class="services-delivery-section section wrap">
  <div class="section-heading">
    <div>
      <span class="eyebrow">Delivery</span>
      <h2>A clearer path from brief to launch.</h2>
    </div>
  </div>
  <div class="fit-rotators">
    <TextRotator label="Problems I solve" items={problemsSolved} />
    <TextRotator label="What you take away" items={outcomes} />
  </div>
</section>
