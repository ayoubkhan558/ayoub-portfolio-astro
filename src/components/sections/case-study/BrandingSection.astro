---
import SectionHeader from "../../portfolio/SectionHeader.astro";
import Asset from "../../portfolio/Asset.astro";
import type { CaseStudyDetailData } from "../../../data/caseStudyDetails";
interface Props {
  study: CaseStudyDetailData;
}
const { study } = Astro.props;
---

<section class="case-study-branding-section">
  <SectionHeader
    label="Visual identity"
    title={study.branding.title}
    subtitle={study.branding.text}
  />
  <div class="branding-grid">
    <div class="brand-preview">
      {"logoImage" in study.branding && (
        <Asset
          src={study.branding.logoImage}
          alt={`${study.client} logo`}
          class="branding-logo"
        />
      )}
      <strong class="brand-preview__value">{study.branding.logoMark}</strong>
    </div>
    <div>
      <h3>{study.branding.fontName}</h3>
      <p>{study.branding.fontMeta}</p>
      <div class="tags">
        {study.branding.fontFamilies?.map((f) => (
          <span class="tags__label">{f}</span>
        ))}
      </div>
      <div class="palette">
        {study.branding.palette.map((c) => (
          <div class="palette__sample">
            <>
              <div class="swatch" style={{ backgroundColor: c.value }} />
              <strong class="palette__value">{c.label}</strong>
              <small class="palette__note portfolio__note">{c.value}</small>
            </>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
