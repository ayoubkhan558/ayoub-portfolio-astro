---
import PageSpeedReport from "../../portfolio/PageSpeedReport.astro";
import type { CaseStudyDetailData } from "../../../data/caseStudyDetails";
interface Props {
  study: CaseStudyDetailData;
}
const { study } = Astro.props;
---

<section class="case-study-challenges-section">
  <div class="case-study-challenges-section__columns">
    <div class="case-detail__column">
      <span class="eyebrow">Before</span>
      <h2>The challenges</h2>
      {study.challenges.map((c) => (
        <article class="challenge-item">
          <>
            <h3 class="challenge-item__title">{c.title}</h3>
            <p>{c.text}</p>
          </>
        </article>
      ))}
    </div>
    <div class="case-detail__column">
      <span class="eyebrow">After</span>
      <h2>The results</h2>
      {study.results.map((c) => (
        <article class="challenge-item">
          <>
            <h3 class="challenge-item__title">{c.title}</h3>
            <p>{c.text}</p>
          </>
        </article>
      ))}
    </div>
  </div>
  <p class="result-highlight">{study.performanceNote}</p>
  {study.pageSpeed && <PageSpeedReport report={study.pageSpeed} collapsed />}
</section>
