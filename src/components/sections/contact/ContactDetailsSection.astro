---
import p from "../../../data/portfolio.json";
const formId = import.meta.env.PUBLIC_FORMSPREE_ID || "mgojyyqd";
const projectTypes = [
  "Business website redesign",
  "WordPress / Bricks Builder build",
  "WooCommerce store improvement",
  "React / Next.js front end",
  "Landing page or funnel",
  "Existing site speed or cleanup",
];
const budgets = [
  "Under $1,000",
  "$1,000 - $3,000",
  "$3,000 - $7,500",
  "$7,500+",
  "Not sure yet",
];
const timelines = [
  "ASAP",
  "2-4 weeks",
  "1-2 months",
  "Flexible / planning ahead",
];
---

<section class="contact-details-section section wrap first-section contact-layout">
  <div class="contact-info">
    <div class="contact-availability">
      <span class="eyebrow">Available for</span>
      <span class="availability">
        <i></i>
        {p.profile.availability}
      </span>
    </div>
    <h2 class="spaced">Let's build something useful.</h2>
    <p>{p.profile.summary}</p>
    <a class="contact-link" href={`mailto:${p.profile.email}`}>
      <span>Email</span>
      {p.profile.email} ↗
    </a>
    <a class="contact-link" href={`tel:${p.profile.phone.replaceAll(" ", "")}`}>
      <span>Phone</span>
      {p.profile.phone} ↗
    </a>
    <a
      class="contact-link"
      href={p.profile.linkedin}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span>Connect</span>LinkedIn ↗
    </a>
    <a
      class="contact-link"
      href={p.profile.upwork}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span>Hire</span>Upwork ↗
    </a>
    <p class="spaced">Based in {p.profile.location}</p>
  </div>
  <form
    class="contact-form"
    id="contact-form"
    method="POST"
    action={`https://formspree.io/f/${formId}`}
  >
    <span class="eyebrow">Project brief</span>
    <h2>What to send.</h2>
    <p>
      Give me enough context to price the next step without a long discovery
      call.
    </p>
    <div
      class="form-message"
      id="form-message"
      role="status"
      aria-live="polite"
      tabindex="-1"
      hidden
    ></div>
    <div class="form-grid">
      <label class="form-field">
        Name
        <input
          name="name"
          autocomplete="name"
          placeholder="Your name"
          required
        />
      </label>
      <label class="form-field">
        Email
        <input
          name="email"
          type="email"
          autocomplete="email"
          placeholder="you@company.com"
          required
        />
      </label>
    </div>
    <label class="form-field">
      Subject
      <input name="_subject" placeholder="Website build estimate" required />
    </label>
    <label class="form-field">
      Project type
      <select name="projectType" required>
        <option value="" disabled selected>
          Choose one
        </option>
        {projectTypes.map((v) => (
          <option>{v}</option>
        ))}
      </select>
    </label>
    <div class="form-grid spaced">
      <label class="form-field">
        Budget range
        <select name="budgetRange">
          <option value="" selected>
            Choose one
          </option>
          {budgets.map((v) => (
            <option>{v}</option>
          ))}
        </select>
      </label>
      <label class="form-field">
        Timeline
        <select name="timeline">
          <option value="" selected>
            Choose one
          </option>
          {timelines.map((v) => (
            <option>{v}</option>
          ))}
        </select>
      </label>
    </div>
    <label class="form-field">
      Website or reference link
      <input name="websiteUrl" type="url" placeholder="https://" />
    </label>
    <label class="form-field">
      Project details
      <textarea
        name="message"
        placeholder="Your goals, current blockers, reference links, and what success looks like…"
        required
      ></textarea>
    </label>
    <input
      type="text"
      name="_gotcha"
      tabindex="-1"
      aria-hidden="true"
      autocomplete="off"
    />
    <button class="button" type="submit" id="send-brief">
      Send project brief ↗
    </button>
    <p class="consent">
      By submitting, you agree to the{" "}
      <a href="/privacy-policy/">privacy policy</a>. Prefer email?{" "}
      <a href={`mailto:${p.profile.email}`}>Write directly</a>.
    </p>
  </form>
</section>
