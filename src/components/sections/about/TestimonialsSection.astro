---
import IntegrationOrbit from "../../portfolio/IntegrationOrbit.astro";
import SectionHeader from "../../portfolio/SectionHeader.astro";
import TestimonialsSection from "../shared/TestimonialsSection.astro";
import p from "../../../data/portfolio.json";

const clientIcons = p.clients
  .filter((client) => client.showInLogos)
  .map(({ logo, name }) => ({ src: logo, label: name }));
const outerCount = Math.ceil(clientIcons.length * 2 / 3);
---

<TestimonialsSection
  class="about-testimonials"
  layoutClass="about-testimonials-section__layout"
  reviewsClass="about-testimonials-section__reviews"
  title="Notes from clients"
  journal
>
  <div slot="intro">
    <SectionHeader label="Testimonials" title="Notes from clients" />
    <IntegrationOrbit
      center={{ src: "/ayoub-about-v4.jpg", label: "Muhammad Ayoub" }}
      outer={clientIcons.slice(0, outerCount)}
      inner={clientIcons.slice(outerCount)}
      label="Client logos"
      centerPortrait
      whiteTiles
    />
  </div>
</TestimonialsSection>
