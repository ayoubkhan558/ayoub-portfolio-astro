---
import SectionHeader from "../../portfolio/SectionHeader.astro";
import p from "../../../data/portfolio.json";
---

<section class="portfolio-background section-spacing">
  <div class="container">
    <SectionHeader
      label={p.about.careerStartLabel}
      title="How my work has changed"
    />
    <div class="timeline">
      {p.about.careerPath.map((c) => (
        <article class="timeline__item">
          <span class="eyebrow">{c.year}</span>
          <h3 class="timeline__title portfolio__heading portfolio__heading--subsection">{c.title}</h3>
          <p class="timeline__description portfolio__paragraph">{c.description}</p>
          <span class="tag">{c.technologies}</span>
        </article>
      ))}
    </div>
  </div>
</section>
