---
import Heading from "../../portfolio/Heading.astro";
import p from "../../../data/portfolio.json";
---

<section class="about-story-section">
  <Heading label="My story" title="Learning by building." />
  <div class="about-story-section__columns">
    <p class="lead portfolio__paragraph">{p.about.originStory}</p>
    <p class="lead portfolio__paragraph">{p.about.motivation}</p>
  </div>
  <div class="about-story-section__cards">
    {p.about.storyCards.map((s) => (
      <article class="plain-card">
        <span class="eyebrow">{s.label}</span>
        <h3 class="plain-card__title portfolio__heading-tertiary">{s.title}</h3>
        <p class="plain-card__description portfolio__paragraph">{s.text}</p>
      </article>
    ))}
  </div>
</section>
