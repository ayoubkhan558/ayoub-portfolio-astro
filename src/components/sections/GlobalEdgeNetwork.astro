---
import EdgeGlobe from "../portfolio/EdgeGlobe.astro";
import SectionHeader from "../portfolio/SectionHeader.astro";
import Asset from "../portfolio/Asset.astro";
import portfolio from "../../data/portfolio.json";
import type { City, Route } from "../portfolio/edge-globe";

interface Props {
  id?: string;
  title?: string;
  description?: string;
  longitude?: number;
  network?: { cities: City[]; routes: Route[] };
}
const locations: [string, number, number][] = [
  ["San Francisco", 37.77, -122.42],
  ["New York", 40.71, -74.01],
  ["São Paulo", -23.55, -46.63],
  ["London", 51.51, -0.13],
  ["Frankfurt", 50.11, 8.68],
  ["Johannesburg", -26.2, 28.04],
  ["Dubai", 25.2, 55.27],
  ["Singapore", 1.35, 103.82],
  ["Tokyo", 35.68, 139.69],
  ["Sydney", -33.87, 151.21],
];
const exampleCities = locations.map(([name, latitude, longitude]) => ({ name, latitude, longitude }));
const exampleRoutes: Route[] = [[0, 1], [1, 2], [1, 3], [3, 4], [4, 5], [4, 6], [6, 7], [7, 8], [7, 9], [8, 0]];
const {
  id = "global-edge-network",
  title = "From first visit to next step",
  longitude = -65,
  network,
  description = "I build websites around what visitors come to do. For one business, that’s finding the right treatment and booking. For another, it’s understanding their insurance options before requesting a quote.",
} = Astro.props;
const { cities, routes } = network ?? { cities: exampleCities, routes: exampleRoutes };
const projects = [
  { name: "Weinberger Aesthetics", summary: "A clearer path from browsing treatments to booking an appointment." },
  { name: "Studyly", summary: "A cleaner layout that made the learning product easier to explore." },
  { name: "Sunshield Insurance", summary: "Service pages that explain coverage options and guide visitors toward a quote." },
];
const clients = projects.flatMap(({ name, summary }) => {
  const client = portfolio.clients.find(client => client.name === name && client.showInLogos);
  return client?.website ? [{ ...client, summary }] : [];
});
---

<section class="section-spacing" {id}>
  <div class="container edge-network">
    <div class="edge-network__copy">
      <SectionHeader {title} />
      <p class="edge-network__description portfolio__paragraph">{description}</p>
      <ul class="edge-network__projects" role="list">
        {clients.map(client => (
          <li class="edge-network__project portfolio__paragraph">
            <a href={client.website} class="edge-network__client portfolio__link">
              <Asset src={client.logo} class="edge-network__logo" imageClassOnly />
              {client.name}
            </a>
            <p>{client.summary}</p>
          </li>
        ))}
      </ul>
    </div>
    <EdgeGlobe {cities} {routes} {longitude} label={network ? title : "Illustrative network map"} />
  </div>
</section>

<style>
  .edge-network {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 5vw, 5rem);
    align-items: center;
    justify-items: center;
  }
  .edge-network__copy {
    width: 100%;
    max-width: 35rem;
    justify-self: start;
  }
  .edge-network__description {
    margin: 0.85rem 0 0;
    max-width: 49ch;
  }
  .edge-network__projects {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
  }
  .edge-network__project {
    margin: 0;
    padding: 0.75rem 0;
    border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  }
  .edge-network__project p {
    margin: 0.2rem 0 0;
  }
  .edge-network__client {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    max-width: 100%;
    font-weight: 600;
    text-underline-offset: 0.2em;
    vertical-align: baseline;
  }
  .edge-network__logo {
    flex: 0 0 auto;
    width: 1.5em;
    height: 1em;
    object-fit: contain;
    box-sizing: content-box;
    padding: 0.2em;
    border-radius: 0.2em;
    background: #fff;
  }
  @media (max-width: 720px) {
    .edge-network { grid-template-columns: 1fr; }
  }
</style>
