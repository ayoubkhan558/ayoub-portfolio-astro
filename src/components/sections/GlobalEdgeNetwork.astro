---
import EdgeGlobe from "../portfolio/EdgeGlobe.astro";
import type { City, Route } from "../portfolio/edge-globe";

interface Props {
  id?: string;
  longitude?: number;
  network?: { cities: City[]; routes: Route[] };
}
const locations: [string, number, number][] = [
  ["San Francisco", 37.77, -122.42],
  ["New York", 40.71, -74.01],
  ["São Paulo", -23.55, -46.63],
  ["London", 51.51, -0.13],
  ["Frankfurt", 50.11, 8.68],
  ["Johannesburg", -26.2, 28.04],
  ["Dubai", 25.2, 55.27],
  ["Singapore", 1.35, 103.82],
  ["Tokyo", 35.68, 139.69],
  ["Sydney", -33.87, 151.21],
];
const exampleCities = locations.map(([name, latitude, longitude]) => ({ name, latitude, longitude }));
const exampleRoutes: Route[] = [[0, 1], [1, 2], [1, 3], [3, 4], [4, 5], [4, 6], [6, 7], [7, 8], [7, 9], [8, 0]];
const {
  id = "global-edge-network",
  longitude = -65,
  network,
} = Astro.props;
const { cities, routes } = network ?? { cities: exampleCities, routes: exampleRoutes };
---

<div class="edge-network" {id}>
  <div class="edge-network__copy">
    <h2 class="portfolio__heading portfolio__heading--section">Build together from anywhere</h2>
      <p class="edge-network__description portfolio__paragraph">I work remotely with teams that need a new site or a better version of the one they have. We agree on what to build, review it in a staging link, and work through feedback before launch.</p>
    <a href="/contact/" class="button portfolio__link">Tell me about your project →</a>
  </div>
  <EdgeGlobe {cities} {routes} {longitude} label={network ? "Network map" : "Illustrative network map"} />
</div>

<style>
  .edge-network {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(1rem, 5vw, 5rem);
    align-items: center;
    justify-items: center;
  }
  .edge-network__copy {
    width: 100%;
    max-width: 35rem;
    justify-self: start;
  }
  .edge-network__copy :global(.button) { margin-block-start: 1.25rem; }
  .edge-network__description {
    margin: 0.85rem 0 0;
    max-width: 49ch;
  }
  @media (max-width: 720px) {
    .edge-network { grid-template-columns: 1fr; }
  }
</style>
