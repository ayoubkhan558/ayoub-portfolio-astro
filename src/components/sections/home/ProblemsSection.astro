---
import Heading from "../../portfolio/Heading.astro";
import TextRotator from "../../portfolio/TextRotator.astro";
import { painPoints, problemsSolved } from "./problems";
---

<section class="home-problems-section" id="problems">
  <Heading
    label="Common problems"
    title="Website problems I can help with"
    subtitle="Start with what’s getting in the way on your current site."
  />
  <div class="home-problems-section__cards">
    {painPoints.map((point) => (
      <article class="plain-card">
        <h3 class="plain-card__title">{point}</h3>
      </article>
    ))}
  </div>
  <div class="fit-rotators single-rotator home-problems-section__project-fit">
    <TextRotator label="Problems I solve" items={problemsSolved} />
  </div>
  <!-- <div class="tags industries">
    {p.trustMarquee.map((v) => (
      <span>{v.name}</span>
    ))}
  </div> -->
</section>
