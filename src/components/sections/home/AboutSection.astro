---
import p from "../../../data/portfolio.json";
import Asset from "../../portfolio/Asset.astro";
import SectionHeader from "../../portfolio/SectionHeader.astro";
---

<section class="home-about-section" id="about">
  <div class="home-about">
    <div>
      <SectionHeader
        label="About me"
        title="About Ayoub"
        subtitle={p.about.homeIntro}
      />
      <div class="home-about-section__actions">
        <a href="/about/" class="button">
          Meet {p.profile.name} →
        </a>
        <a href={p.about.resumeHref} class="text-link" download>
          Download Resume ↓
        </a>
      </div>
      <div class="tags home-about-section__tags">
        {p.recognition.map((v) => (
          <span class="tags__label">
            {v.label} · {v.status}
          </span>
        ))}
      </div>
    </div>
    <figure class="home-about__figure">
      <Asset
        src="/ayoub-about-v4.jpg"
        alt={`${p.profile.name}, web developer and SEO specialist`}
        class="home-portrait"
      />
      <figcaption class="home-about__caption">
        {p.profile.name} · {p.profile.location}
      </figcaption>
    </figure>
  </div>
</section>
