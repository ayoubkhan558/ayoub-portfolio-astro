---
import CaseGrid from "../../portfolio/CaseGrid.astro";
import SectionHeader from "../../portfolio/SectionHeader.astro";
---

<section
  class="section-spacing"
  id="case-studies"
  data-project-reveal
>
  <div class="container">
    <SectionHeader
      label="Case studies"
      title="How the work came together"
      subtitle="What each client needed, what I changed, and how it turned out."
    />
    <CaseGrid limit={3} />
    <div class="home-case-studies-section__footer">
      <a href="/case-studies/" class="button button--outline portfolio__link">
        Show all case studies →
      </a>
    </div>
  </div>
</section>
