---
import ProjectCard from "../../portfolio/ProjectCard.astro";
import {
  sortProjectsByLiveStatus,
  projectPlatformFilters,
  projectStatusFilters,
} from "../../../data/projectsArchive";
import archive from "../../../data/projectsArchive.json";
import { siteSettings } from "../../../config/siteSettings";
const projects = sortProjectsByLiveStatus(archive.projects);
---

<section
  class="project-archive-section"
  id="archive"
  data-projects-per-page={siteSettings.projectsPerPage}
>
  <div class="project-archive__controls">
  <form class="project-toolbar" id="project-filters" role="search">
    <label class="project-toolbar__field" for="project-search">
      Search projects
      <input class="project-toolbar__input portfolio__input"
        id="project-search"
        name="q"
        type="search"
        placeholder="Search name, industry, stack…"
      />
    </label>
    <label class="project-toolbar__field" for="platform-filter">
      Platform
      <select class="project-toolbar__select portfolio__select" id="platform-filter" name="platform">
        {projectPlatformFilters.map((p) => (
          <option value={p.value}>{p.label}</option>
        ))}
      </select>
    </label>
    <label class="project-toolbar__field" for="status-filter">
      Original project status
      <select class="project-toolbar__select portfolio__select" id="status-filter" name="status">
        {projectStatusFilters.map((p) => (
          <option value={p.value}>{p.label}</option>
        ))}
      </select>
    </label>
  </form>
  <p
    class="project-count"
    id="project-count"
    tabindex="-1"
    aria-live="polite"
    aria-atomic="true"
  >
    {projects.length} projects · status labels are from the original portfolio,
    not a current uptime check.
  </p>
  </div>

  <hr ><br>

  <div class="project-grid" id="project-grid">
    {projects.map((p, index) => (
      <ProjectCard project={p} index={index} />
    ))}
  </div>
  <div class="empty-state" id="no-projects" hidden>
    <h2>No matching projects.</h2>
    <p>Try a different keyword or clear your filters.</p>
    <button class="button button--outline portfolio__button" id="clear-filters">
      Clear filters
    </button>
  </div>
  <div class="pagination" id="pagination" hidden>
    <button type="button" class="button button--outline pagination__button portfolio__button" id="prev-page">
      ← Previous
    </button>
    <span class="pagination__label" id="page-label" aria-live="polite"></span>
    <button type="button" class="button button--outline pagination__button portfolio__button" id="next-page">
      Next →
    </button>
  </div>
  <div class="project-copy-tools">
    <button
      type="button"
      class="project-archive__copy"
      id="open-project-copy"
      aria-haspopup="dialog"
      aria-controls="project-copy-dialog"
    >
      <svg
        aria-hidden="true"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="8" y="8" width="13" height="13" rx="2"></rect>
        <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"></path>
      </svg>
      <!-- Copy project links -->
    </button>
    <dialog
      class="project-copy-dialog"
      id="project-copy-dialog"
      aria-labelledby="project-copy-heading"
    >
      <div class="project-copy-panel">
        <header class="project-copy-header">
          <div>
            <span class="eyebrow">Project link builder</span>
            <h2 class="project-copy-header__title" id="project-copy-heading">Copy project links</h2>
          </div>
          <button
            type="button"
            class="button button--outline project-copy-close portfolio__button"
            id="close-project-copy"
          >
            Close
          </button>
        </header>
        <div class="project-copy-fields">
          <label class="project-copy-fields__field" for="copy-list-title">
            List title
            <input class="portfolio__input"
              id="copy-list-title"
              type="text"
              maxlength="100"
              value="Ayoub's projects"
            />
          </label>
          <label class="project-copy-fields__field" for="copy-project-platform">
            Project group
            <select class="portfolio__select" id="copy-project-platform">
              {projectPlatformFilters
                .filter((filter) => filter.value !== "all")
                .map((filter, index) => (
                  <option value={filter.value} selected={index === 0}>
                    {filter.label}
                  </option>
                ))}
            </select>
          </label>
          <label class="project-copy-fields__field" for="copy-project-status">
            Project status
            <select class="portfolio__select" id="copy-project-status">
              <option value="Live">Live</option>
              <option value="Offline (Domain Expired)">Expired</option>
              <option value="Redesigned by Client">Redesigned</option>
            </select>
          </label>
          <label class="project-copy-fields__field" for="copy-output-format">
            Output format
            <select class="portfolio__select" id="copy-output-format">
              <option value="detailed">Detailed list</option>
              <option value="markdown">Markdown</option>
              <option value="urls">Links only</option>
            </select>
          </label>
          <div class="project-copy-options">
            <label class="project-copy-fields__field project-copy-options__field">
              <input class="project-copy-options__input portfolio__input" id="copy-include-title" type="checkbox" checked />
              Include title
            </label>
            <label class="project-copy-fields__field project-copy-options__field">
              <input class="project-copy-options__input portfolio__input" id="copy-include-category" type="checkbox" />
              Include categories
            </label>
          </div>
          <div class="project-copy-actions">
            <button type="button" class="button project-copy-actions__button portfolio__button" id="copy-all-projects">
              Copy all
            </button>
            <button
              type="button"
              class="button button--outline project-copy-actions__button portfolio__button"
              id="copy-project-group"
            >
              Copy group
            </button>
          </div>
          <p
            class="project-copy-status"
            id="project-copy-status"
            aria-live="polite"
            aria-atomic="true"
          >
            Copy links by status, optionally limited to a platform group.
          </p>
        </div>
      </div>
    </dialog>
  </div>
  <noscript>
    <style>
      .project-toolbar {
        display: none;
      }
      .project-copy-tools {
        display: none;
      }
    </style>
    <p>
      All projects are shown. Enable JavaScript to use search, filters, and
      pagination.
    </p>
  </noscript>
</section>
