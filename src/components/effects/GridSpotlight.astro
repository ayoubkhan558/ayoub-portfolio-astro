<script>
  const motion = matchMedia(
    "(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)",
  );
  for (const grid of document.querySelectorAll<HTMLElement>(
    "[data-grid-spotlight]",
  )) {
    const cards = [
      ...grid.querySelectorAll<HTMLElement>("[data-spotlight-card]"),
    ];
    grid.addEventListener(
      "pointermove",
      (event) => {
        if (!motion.matches || event.pointerType === "touch") return;
        const bounds = cards.map((card) => card.getBoundingClientRect());
        cards.forEach((card, index) => {
          card.style.setProperty(
            "--x",
            `${event.clientX - bounds[index].left}px`,
          );
          card.style.setProperty(
            "--y",
            `${event.clientY - bounds[index].top}px`,
          );
        });
        grid.classList.add("grid-spotlight--active");
      },
      { passive: true },
    );
    const hide = () => grid.classList.remove("grid-spotlight--active");
    grid.addEventListener("pointerleave", hide);
    motion.addEventListener("change", hide);
  }
</script>
