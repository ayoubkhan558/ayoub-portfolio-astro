---
import tools from "../../data/toolCatalog.json";
import { aiToolKeys } from "../../data/toolCatalog";

const keys = [
  "html",
  "css",
  "javascript",
  "typescript",
  "figma",
  "nextjs",
  "graphql",
  "redux",
  "material-ui",
  "bootstrap",
  "bulma",
  "tailwind",
  "gsap",
  "swiperjs",
  "accessibility",
  "php",
  "rest-api",
  "plyr",
  "scrollreveal",
  "jquery",
  "postcss",
  "sass",
  "shopify",
  "webflow",
  "vite",
  "vercel",
  "git",
  "npm",
  "postman",
  "json",
  "seo",
  "rank-math",
  "yoast-seo",
  "vs-code",
  "mysql",
  "phpmyadmin",
  "admin-columns-pro",
  "chaty",
  "litespeed-cache",
  "meta-pixel",
  "microsoft-clarity",
  "bricks-builder",
  "advanced-custom-fields",
  "slim-seo",
  "seopress",
  "google-site-kit",
  "happyfiles",
  "wpc-admin-columns",
  "wordpress",
  "woocommerce",
  "elementor",
  ...aiToolKeys,
] as const;

const logos = keys.map((key) => tools[key]).filter((tool) => tool?.logo);
---

<div data-gravity-demo>
  <button type="button" class="button button--outline" data-gravity-toggle aria-pressed="false" aria-controls="gravity-skill-logos" hidden>Animate skill logos</button>
  <ul
    id="gravity-skill-logos"
    class="gravity-logos"
    data-gravity-logos
    aria-label="Skills and technology logos"
  >
    {logos.map(({ name, logo }) => (
      <li class="gravity-logos__piece">
        <img
          class="gravity-logos__logo"
          src={logo}
          alt={name}
          width="38"
          height="38"
          draggable="false"
          loading="lazy"
        />
      </li>
    ))}
  </ul>
</div>

<style>
  [data-gravity-toggle][hidden] { display: none; }
</style>

<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");

  for (const demo of document.querySelectorAll<HTMLElement>("[data-gravity-demo]")) {
    const stage = demo.querySelector<HTMLElement>("[data-gravity-logos]");
    const toggle = demo.querySelector<HTMLButtonElement>("[data-gravity-toggle]");
    if (!stage || !toggle) continue;
    let stop: (() => void) | undefined;
    let enabled = false;
    let inView = false;
    const motionButton = toggle;

    async function start() {
      if (!enabled || reduced.matches || !inView || stop) return;
      try {
        const { startGravityLogos } = await import("./gravityLogoPhysics");
        if (!enabled || reduced.matches || !inView || stop) return;
        stop = startGravityLogos(stage!);
      } catch {
        enabled = false;
        motionButton.setAttribute("aria-pressed", "false");
      }
    }

    function stopAnimation() {
      stop?.();
      stop = undefined;
    }

    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      if (inView) void start();
      else stopAnimation();
    }).observe(stage);

    function syncMotionPreference() {
      motionButton.hidden = reduced.matches;
      if (reduced.matches) {
        enabled = false;
        motionButton.setAttribute("aria-pressed", "false");
        stopAnimation();
      }
    }

    toggle.addEventListener("click", () => {
      enabled = !enabled;
      toggle.setAttribute("aria-pressed", String(enabled));
      if (enabled) void start();
      else stopAnimation();
    });
    reduced.addEventListener("change", syncMotionPreference);
    syncMotionPreference();
  }
</script>
