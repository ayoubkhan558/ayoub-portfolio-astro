<script>
  const targets = "[data-glare-sweep]";
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");

  function sweep(target: HTMLElement) {
    target.classList.add("glare-sweep");
    if (getComputedStyle(target).position === "static") {
      target.classList.add("glare-sweep--positioned");
    }
    if (reduced.matches) return;
    const edge =
      target.offsetHeight * Math.sin(Math.PI / 9) + target.offsetWidth * 0.4;
    target.style.setProperty("--glare-edge", `${edge}px`);
    target.style.setProperty("--glare-end", `${target.offsetWidth + edge}px`);
    target.classList.remove("glare-sweep--running");
    // Restart on a new entry even when the previous pass is still running.
    void target.offsetWidth;
    target.classList.add("glare-sweep--running");
  }

  document.addEventListener("pointerover", (event) => {
    if (event.pointerType === "touch" || !(event.target instanceof Element))
      return;
    for (
      let target = event.target.closest<HTMLElement>(targets);
      target;
      target = target.parentElement?.closest<HTMLElement>(targets) ?? null
    ) {
      if (
        !(event.relatedTarget instanceof Node) ||
        !target.contains(event.relatedTarget)
      )
        sweep(target);
    }
  });

  document.addEventListener("focusin", (event) => {
    if (
      !(event.target instanceof Element) ||
      !event.target.matches(":focus-visible")
    )
      return;
    for (
      let target = event.target.closest<HTMLElement>(targets);
      target;
      target = target.parentElement?.closest<HTMLElement>(targets) ?? null
    ) {
      sweep(target);
    }
  });
</script>
