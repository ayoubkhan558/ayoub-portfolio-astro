<script>
  const motion = matchMedia(
    "(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)",
  );

  for (const area of document.querySelectorAll<HTMLElement>("[data-emoji-trail]")) {
    let loading = false;
    // Load the animation and icon data only for visitors who hover the CTA.
    const load = async (event: PointerEvent) => {
      if (!motion.matches || event.pointerType !== "mouse" || loading) return;
      loading = true;
      try {
        const { attachEmojiTrail } = await import("./emojiTrailMotion");
        attachEmojiTrail(area, motion);
        area.removeEventListener("pointerenter", load);
      } catch {
        // The decorative effect can be retried on the next hover.
      } finally {
        loading = false;
      }
    };
    area.addEventListener("pointerenter", load);
  }
</script>
