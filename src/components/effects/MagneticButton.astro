<script>
  import { createSpring } from "../../lib/pointerSpring";

  const magnetic = matchMedia(
    "(pointer: fine) and (prefers-reduced-motion: no-preference)",
  );
  const buttons = [
    ...document.querySelectorAll<HTMLElement>("[data-magnetic-button]"),
  ].map((element) => ({
    element,
    x: createSpring(),
    y: createSpring(),
    offsetX: 0,
    offsetY: 0,
  }));
  let pointer: { x: number; y: number } | undefined;
  let frame = 0;

  function moveButtons() {
    let moving = false;
    for (const button of buttons) {
      let targetX = 0;
      let targetY = 0;

      if (pointer && !button.element.matches(":focus-visible")) {
        const rect = button.element.getBoundingClientRect();
        const left = rect.left - button.offsetX;
        const top = rect.top - button.offsetY;
        const gapX = Math.max(
          left - pointer.x,
          0,
          pointer.x - left - rect.width,
        );
        const gapY = Math.max(
          top - pointer.y,
          0,
          pointer.y - top - rect.height,
        );
        const proximity = Math.hypot(gapX, gapY);
        const dx = pointer.x - left - rect.width / 2;
        const dy = pointer.y - top - rect.height / 2;
        const distance = Math.hypot(dx, dy);
        const pull =
          Math.max(0, 1 - proximity / 80) *
          Math.min(0.25, 14 / (distance || 1));
        targetX = dx * pull;
        targetY = dy * pull;
      }

      const x = button.x.step(targetX);
      const y = button.y.step(targetY);
      const limit = Math.min(1, 14 / (Math.hypot(x, y) || 1));
      button.offsetX = x * limit;
      button.offsetY = y * limit;
      button.element.style.setProperty(
        "--magnetic-offset",
        `${button.offsetX}px ${button.offsetY}px`,
      );
      moving ||= x !== targetX || y !== targetY;
    }
    frame = moving ? requestAnimationFrame(moveButtons) : 0;
  }

  window.addEventListener(
    "pointermove",
    (event) => {
      if (!magnetic.matches || event.pointerType === "touch") return;
      pointer = { x: event.clientX, y: event.clientY };
      if (!frame) frame = requestAnimationFrame(moveButtons);
    },
    { passive: true },
  );

  document.documentElement.addEventListener("pointerleave", () => {
    pointer = undefined;
    if (magnetic.matches && !frame) frame = requestAnimationFrame(moveButtons);
  });

  magnetic.addEventListener("change", () => {
    pointer = undefined;
    cancelAnimationFrame(frame);
    frame = 0;
    for (const button of buttons) {
      button.x = createSpring();
      button.y = createSpring();
      button.offsetX = button.offsetY = 0;
      button.element.style.removeProperty("--magnetic-offset");
    }
  });
</script>
