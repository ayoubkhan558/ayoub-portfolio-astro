---
import Layout from "../layouts/PortfolioLayout.astro";
import NameSparkles from "../components/effects/NameSparkles.astro";
import Intro from "../components/portfolio/Intro.astro";
import Asset from "../components/portfolio/Asset.astro";
import CTA from "../components/portfolio/CTA.astro";
import p from "../data/portfolio.json";
import StorySection from "../components/sections/about/StorySection.astro";
import CareerSection from "../components/sections/about/CareerSection.astro";
import ExperienceSection from "../components/sections/about/ExperienceSection.astro";
import ToolboxSection from "../components/sections/about/ToolboxSection.astro";
import TestimonialsSection from "../components/sections/about/TestimonialsSection.astro";
import ExternalArrow from "../components/portfolio/ExternalArrow.astro";
---

<Layout title="About">
  <div class="about-page">
    <div class="portfolio-background">
      <Intro label="A little about me" description={p.profile.role}>
        <NameSparkles slot="title">{p.profile.name}</NameSparkles>
      </Intro>
      <div class="about-hero">
        <Asset
          src="/ayoub-about-v4.jpg"
          alt={p.profile.name}
          class="portrait"
          eager
        />
        <div>
          <span class="eyebrow">Hi, I'm M. Ayoub Khan</span>
          <h2 class="about-hero__title">I learned the hard way, and that made me patient.</h2>
          <p class="lead">{p.about.story}</p>
          <div class="about-hero__actions">
            <a href={p.about.resumeHref} class="button" download>
              Download Resume ↓
            </a>
            <a
              href={p.profile.upwork}
              class="text-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              Upwork profile <ExternalArrow />
            </a>
          </div>
          <div class="education-note">
            <span class="eyebrow">Education</span>
            <p class="education-note__description">{p.about.education}</p>
          </div>
          <p class="small-note">
            Currently building: {p.profile.currentlyBuilding}
          </p>
        </div>
      </div>
      <div class="stats-row">
        {p.about.awards.map((a) => (
          <div class="stats-row__metric">
            <strong class="stats-row__value">{a.value}</strong>
            <p class="stats-row__description">{a.label}</p>
          </div>
        ))}
      </div>
    </div>
    <StorySection />
    <CareerSection />
    <ExperienceSection />
    <ToolboxSection />
    <TestimonialsSection />
    <div class="portfolio-background portfolio-background--bottom">
      <CTA />
    </div>
  </div>
</Layout>
