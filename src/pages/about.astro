---
import Layout from "../layouts/PortfolioLayout.astro";
import Intro from "../components/portfolio/Intro.astro";
import Asset from "../components/portfolio/Asset.astro";
import CTA from "../components/portfolio/CTA.astro";
import p from "../data/portfolio.json";
import StorySection from "../components/sections/about/StorySection.astro";
import CareerSection from "../components/sections/about/CareerSection.astro";
import ExperienceSection from "../components/sections/about/ExperienceSection.astro";
import ToolboxSection from "../components/sections/about/ToolboxSection.astro";
import TestimonialsSection from "../components/sections/about/TestimonialsSection.astro";
---

<Layout title="About">
  <div class="about-page">
    <div class="portfolio-background">
      <Intro
        label="A little about me"
        title={p.profile.name}
        description={p.profile.role}
      />
      <div class="wrap about-hero">
        <Asset
          src="/ayoub-about-v4.jpg"
          alt={p.profile.name}
          class="portrait"
          eager
        />
        <div>
          <span class="eyebrow">{p.profile.location}</span>
          <h2>
            Resourceful by nature.
            <br />
            Developer by craft.
          </h2>
          <p class="lead">{p.about.story}</p>
          <div class="actions">
            <a href={p.about.resumeHref} class="button" download>
              Download Resume ↓
            </a>
            <a
              href={p.profile.upwork}
              class="text-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              Upwork profile ↗
            </a>
          </div>
          <div class="education-note">
            <span class="eyebrow">Education</span>
            <p>{p.about.education}</p>
          </div>
          <p class="small-note">
            Currently building: {p.profile.currentlyBuilding}
          </p>
        </div>
      </div>
      <div class="wrap stats-row">
        {p.about.awards.map((a) => (
          <div>
            <strong>{a.value}</strong>
            <p>{a.label}</p>
          </div>
        ))}
      </div>
    </div>
    <StorySection />
    <CareerSection />
    <ExperienceSection />
    <ToolboxSection />
    <TestimonialsSection />
    <div class="portfolio-background bottom">
      <CTA />
    </div>
  </div>
</Layout>
