---
import Layout from "../layouts/PortfolioLayout.astro";
import Intro from "../components/portfolio/Intro.astro";
import Heading from "../components/portfolio/Heading.astro";
import Asset from "../components/portfolio/Asset.astro";
import CTA from "../components/portfolio/CTA.astro";
import p from "../data/portfolio.json";
import SkillsMarquee from "../components/portfolio/SkillsMarquee.astro";
import Testimonials from "../components/portfolio/Testimonials.astro";
---

<Layout title="About">
  <div class="about-page">
    <div class="portfolio-background">
      <Intro
        label="A little about me"
        title={p.profile.name}
        description={p.profile.role}
      />
      <div class="wrap about-hero">
        <Asset
          src="/ayoub-about-v4.jpg"
          alt={p.profile.name}
          class="portrait"
          eager
        />
        <div>
          <span class="eyebrow">{p.profile.location}</span>
          <h2>
            Resourceful by nature.
            <br />
            Developer by craft.
          </h2>
          <p class="lead">{p.about.story}</p>
          <div class="actions">
            <a href={p.about.resumeHref} class="button" download>
              Download Resume ↓
            </a>
            <a
              href={p.profile.upwork}
              class="text-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              Upwork profile ↗
            </a>
          </div>
          <div class="education-note">
            <span class="eyebrow">Education</span>
            <p>{p.about.education}</p>
          </div>
          <p class="small-note">
            Currently building: {p.profile.currentlyBuilding}
          </p>
        </div>
      </div>
      <div class="wrap stats-row">
        {p.about.awards.map((a) => (
          <div>
            <strong>{a.value}</strong>
            <p>{a.label}</p>
          </div>
        ))}
      </div>
    </div>
    <section class="section wrap">
      <Heading label="My story" title="Learning by building." />
      <div class="two-grid">
        <p class="lead">{p.about.originStory}</p>
        <p class="lead">{p.about.motivation}</p>
      </div>
      <div class="three-grid spaced">
        {p.about.storyCards.map((s) => (
          <article class="plain-card">
            <span class="eyebrow">{s.label}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
      <p class="signature">{p.about.signature}</p>
    </section>
    <section class="section wrap">
      <Heading
        label={p.about.careerStartLabel}
        title="A path built one skill at a time."
      />
      <div class="timeline">
        {p.about.careerPath.map((c) => (
          <article>
            <span class="eyebrow">{c.year}</span>
            <h3>{c.title}</h3>
            <p>{c.description}</p>
            <span class="tag">{c.technologies}</span>
          </article>
        ))}
      </div>
    </section>
    <section class="section wrap">
      <Heading label="Experience" title="Teams I've built with." />
      <div class="experience-list">
        {p.experienceLog.map((e) => (
          <article>
            <Asset src={e.logo} alt={e.company} class="company-logo" />
            <div>
              <span class="eyebrow">
                {e.year} · {e.duration}
              </span>
              <h3>{e.title}</h3>
              <p>
                <strong>{e.company}</strong> · {e.location}
              </p>
              <p>{e.description}</p>
              <p class="small-note">
                <time datetime={e.startDate}>{e.startDate}</time> →{" "}
                <time datetime={e.endDate}>{e.endDate}</time>
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="section wrap">
      <Heading label="Toolbox" title="The right tools for the job." />
      <div class="compact-toolbox">
        {p.about.toolbox.map((t, i) => (
          <article>
            <div>
              <span class="toolbox-index">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3>{t.title}</h3>
            </div>
            <ul>
              {t.items.map((v) => (
                <li>{v}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <div class="skills-title">
        <h3>Skills & technologies</h3>
        <p>Familiar tools. Thoughtful choices.</p>
      </div>
      <SkillsMarquee />
    </section>
    <section class="section wrap about-testimonials">
      <Heading
        label="Testimonials"
        title="What it’s like to work together."
        subtitle="Client feedback from real projects."
      />
      <Testimonials />
    </section>
    <div class="portfolio-background bottom">
      <CTA />
    </div>
  </div>
</Layout>
