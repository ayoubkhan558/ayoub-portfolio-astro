---
import CTA from "../components/portfolio/CTA.astro";
import Intro from "../components/portfolio/Intro.astro";
import ProjectArchiveSection from "../components/sections/projects/ProjectArchiveSection.astro";
import Layout from "../layouts/PortfolioLayout.astro";
---

<Layout hasFooterCta title="Projects">
  <div class="portfolio-background">
    <Intro
      title="Project archive"
      description="Browse client websites, product interfaces, and tools I’ve built."
    />
    <ProjectArchiveSection />
  </div>
  <CTA />
</Layout>
<script>
  const cards = [...document.querySelectorAll<HTMLElement>(".project-card")];
  const search = document.querySelector<HTMLInputElement>("#project-search")!;
  const platform =
    document.querySelector<HTMLSelectElement>("#platform-filter")!;
  const status = document.querySelector<HTMLSelectElement>("#status-filter")!;
  const form = document.querySelector<HTMLFormElement>("#project-filters")!;
  const count = document.querySelector<HTMLElement>("#project-count")!;
  const empty = document.querySelector<HTMLElement>("#no-projects")!;
  const pagination = document.querySelector<HTMLElement>("#pagination")!;
  const prev = document.querySelector<HTMLButtonElement>("#prev-page")!;
  const next = document.querySelector<HTMLButtonElement>("#next-page")!;
  const label = document.querySelector<HTMLElement>("#page-label")!;
  const statuses: Record<string, string> = {
    all: "",
    live: "Live",
    redesigned: "Redesigned by Client",
    "domain-expired": "Offline (Domain Expired)",
  };
  const perPage = Number(
    document.querySelector<HTMLElement>("#archive")!.dataset.projectsPerPage,
  );
  let page = 1;
  function readURL() {
    const params = new URLSearchParams(location.search);
    search.value = params.get("q") || "";
    const legacy = params.get("filter") || "";
    const p = params.get("platform") || legacy;
    const s = params.get("status") || legacy;
    platform.value = [...platform.options].some((o) => o.value === p)
      ? p
      : "all";
    status.value = Object.hasOwn(statuses, s) ? s : "all";
    const n = Number(params.get("page") || 1);
    page = Number.isSafeInteger(n) && n > 0 ? n : 1;
  }
  function render(historyMode: "none" | "replace" | "push" = "replace") {
    const q = search.value.trim().toLowerCase();
    const matching = cards.filter(
      (card) =>
        (!q || card.dataset.search!.includes(q)) &&
        (platform.value === "all" ||
          card.dataset.platform!.split(" ").includes(platform.value)) &&
        (!statuses[status.value] ||
          card.dataset.status === statuses[status.value]),
    );
    const pages = Math.max(1, Math.ceil(matching.length / perPage));
    page = Math.max(1, Math.min(page, pages));
    cards.forEach((card) => (card.hidden = true));
    const first = (page - 1) * perPage;
    matching
      .slice(first, first + perPage)
      .forEach((card) => (card.hidden = false));
    count.textContent = matching.length
      ? `Showing ${first + 1}–${Math.min(first + perPage, matching.length)} of ${matching.length} matching projects · ${cards.length} total.`
      : `No matching projects · ${cards.length} total.`;
    empty.hidden = matching.length > 0;
    pagination.hidden = matching.length <= perPage;
    prev.disabled = page === 1;
    next.disabled = page === pages;
    label.textContent = `Page ${page} of ${pages}`;
    if (historyMode !== "none") {
      const params = new URLSearchParams();
      if (q) params.set("q", search.value.trim());
      if (platform.value !== "all") params.set("platform", platform.value);
      if (status.value !== "all") params.set("status", status.value);
      if (page > 1) params.set("page", String(page));
      const url =
        location.pathname + (params.size ? "?" + params.toString() : "");
      if (historyMode === "push") history.pushState(null, "", url);
      else history.replaceState(null, "", url);
    }
  }
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    page = 1;
    render();
  });
  [search, platform, status].forEach((control) =>
    control.addEventListener(control === search ? "input" : "change", () => {
      page = 1;
      render();
    }),
  );
  function navigate(delta: number) {
    page += delta;
    render("push");
    count.focus({ preventScroll: true });
    document.querySelector("#archive")?.scrollIntoView({
      behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
        ? "instant"
        : "smooth",
      block: "start",
    });
  }
  prev.addEventListener("click", () => navigate(-1));
  next.addEventListener("click", () => navigate(1));
  document.querySelector("#clear-filters")?.addEventListener("click", () => {
    search.value = "";
    platform.value = "all";
    status.value = "all";
    page = 1;
    render();
    search.focus();
  });
  window.addEventListener("popstate", () => {
    readURL();
    render("none");
  });
  const copyDialog = document.querySelector<HTMLDialogElement>(
    "#project-copy-dialog",
  )!;
  const copyGroup = document.querySelector<HTMLSelectElement>(
    "#copy-project-platform",
  )!;
  const copyProjectStatus = document.querySelector<HTMLSelectElement>(
    "#copy-project-status",
  )!;
  const copyTitle =
    document.querySelector<HTMLInputElement>("#copy-list-title")!;
  const copyFormat = document.querySelector<HTMLSelectElement>(
    "#copy-output-format",
  )!;
  const includeTitle = document.querySelector<HTMLInputElement>(
    "#copy-include-title",
  )!;
  const includeCategory = document.querySelector<HTMLInputElement>(
    "#copy-include-category",
  )!;
  const copyStatus = document.querySelector<HTMLElement>(
    "#project-copy-status",
  )!;
  const copyButtons = [
    document.querySelector<HTMLButtonElement>("#copy-all-projects")!,
    document.querySelector<HTMLButtonElement>("#copy-project-group")!,
  ];
  document
    .querySelector<HTMLButtonElement>("#open-project-copy")!
    .addEventListener("click", () => copyDialog.showModal());
  document
    .querySelector<HTMLButtonElement>("#close-project-copy")!
    .addEventListener("click", () => copyDialog.close());
  copyDialog.addEventListener("click", (event) => {
    if (event.target === copyDialog) copyDialog.close();
  });
  function formatProjectLinks(selected: HTMLElement[]) {
    const records = selected.flatMap((card) => {
      const links = [
        card.dataset.projectWebsite,
        card.dataset.projectFigma,
      ].filter((href): href is string => Boolean(href));
      return links.map((href) => ({
        href,
        title: card.dataset.projectTitle || href,
        category: card.dataset.projectCategory || "",
      }));
    });
    if (!records.length) return "";
    const header = copyTitle.value.trim();
    const list = records.map((record) => {
      const name = includeTitle.checked ? record.title : "";
      const category =
        includeCategory.checked && record.category
          ? ` (${record.category})`
          : "";
      if (copyFormat.value === "urls") return record.href;
      if (copyFormat.value === "markdown") {
        return `- ${name ? `[${name}](${record.href})` : record.href}${category}`;
      }
      return `${name ? `${name} — ` : ""}${record.href}${category}`;
    });
    return [header, ...list].filter(Boolean).join("\n");
  }
  async function copyProjects(group: string | null) {
    const selected = cards.filter(
      (card) =>
        card.dataset.status === copyProjectStatus.value &&
        (!group || card.dataset.platform!.split(" ").includes(group)),
    );
    const content = formatProjectLinks(selected);
    if (!content) {
      copyStatus.textContent = "No project links are available to copy.";
      return;
    }
    copyButtons.forEach((button) => (button.disabled = true));
    try {
      await navigator.clipboard.writeText(content);
      const source = [
        copyProjectStatus.selectedOptions[0].textContent?.trim(),
        ...(group
          ? [`${copyGroup.selectedOptions[0].textContent?.trim()} group`]
          : []),
      ].join(", ");
      copyStatus.textContent = `Copied ${content.split("\n").length - (copyTitle.value.trim() ? 1 : 0)} links from ${source}.`;
    } catch {
      copyStatus.textContent =
        "Could not access the clipboard. Check browser permissions and try again.";
    } finally {
      copyButtons.forEach((button) => (button.disabled = false));
    }
  }
  copyButtons[0].addEventListener("click", () => copyProjects(null));
  copyButtons[1].addEventListener("click", () => copyProjects(copyGroup.value));
  readURL();
  render("none");
</script>
