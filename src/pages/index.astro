---
import { Image } from "astro:assets";
import portrait from "../../public/ayoub-about-v4.jpg";
import SkillBurst from "../components/effects/SkillBurst.astro";
import ProjectReveal from "../components/effects/ProjectReveal.astro";
import Layout from "../layouts/PortfolioLayout.astro";
import homeStyles from "../styles/home.scss?inline";
import p from "../data/portfolio.json";
import { Hero } from "../components/blocks/hero";
import { Background } from "../components/background";
import CTA from "../components/portfolio/CTA.astro";
import TrustSection from "../components/sections/home/TrustSection.astro";
import ProblemsSection from "../components/sections/home/ProblemsSection.astro";
import ServicesSection from "../components/sections/home/ServicesSection.astro";
import ResourceSection from "../components/sections/home/ResourceSection.astro";
import ProjectsSection from "../components/sections/home/ProjectsSection.astro";
import SectionHeader from "../components/portfolio/SectionHeader.astro";
import CaseStudiesSection from "../components/sections/shared/CaseStudiesSection.astro";
import Logos from "../components/portfolio/Logos.astro";
import TestimonialsSection from "../components/sections/shared/TestimonialsSection.astro";
import AboutSection from "../components/sections/home/AboutSection.astro";
import FAQSection from "../components/sections/shared/FAQSection.astro";
---

<Layout hasFooterCta>
  <style slot="head" is:inline set:html={homeStyles}></style>
  <div class="home-page">
    <Background className="portfolio-background">
      <Hero data={p}>
        <Image
          slot="portrait"
          src={portrait}
          alt={p.profile.name}
          class="portfolio__image hero-profile-photo"
          width={160}
          widths={[160, 320]}
          sizes="(min-width: 1120px) 104px, (min-width: 920px) 80px, (min-width: 768px) 104px, 80px"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
      </Hero>
      <TrustSection />
    </Background>
    <ProblemsSection />
    <ProjectsSection />
    <CaseStudiesSection id="case-studies" limit={3} optimizeThumbnails reveal>
      <SectionHeader
        slot="heading"
        label="Case studies"
        title="How the work came together"
        subtitle="What each client needed, what I changed, and how it turned out."
      />
      <div slot="action" class="home-case-studies-section__footer">
        <a href="/case-studies/" class="button button--outline portfolio__link">Show all case studies →</a>
      </div>
    </CaseStudiesSection>
    <Background
      variant="bottom"
      className="portfolio-background portfolio-background--bottom"
    >
      <ServicesSection />
    </Background>
    <ResourceSection />
    <TestimonialsSection id="proof" class="home-testimonials-section" title="What it’s like to work together." subtitle="Client feedback from real projects.">
      <Logos slot="logos" projectsOnly label="Selected project logos" />
    </TestimonialsSection>
    <AboutSection />
    <FAQSection id="faq" items={p.faqs} openFirst>
      <Fragment slot="description">
        If you can't find what you're looking for,
        <a href="/contact/" class="portfolio-faq__link portfolio__link">get in touch</a>.
      </Fragment>
    </FAQSection>
    <Background
      variant="bottom"
      className="portfolio-background portfolio-background--bottom"
    >
      <div id="cta">
        <CTA interactive />
      </div>
    </Background>
  </div>
  <ProjectReveal />
  <SkillBurst />
</Layout>
