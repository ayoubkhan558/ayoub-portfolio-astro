---
import Layout from "../layouts/PortfolioLayout.astro";
import p from "../data/portfolio.json";
import { Hero } from "../components/blocks/hero";
import { Background } from "../components/background";
import { caseStudyDetails } from "../data/caseStudyDetails";
import CTA from "../components/portfolio/CTA.astro";
import TrustSection from "../components/sections/home/TrustSection.astro";
import ProblemsSection from "../components/sections/home/ProblemsSection.astro";
import ServicesSection from "../components/sections/home/ServicesSection.astro";
import ResourceSection from "../components/sections/home/ResourceSection.astro";
import ProjectsSection from "../components/sections/home/ProjectsSection.astro";
import CaseStudiesSection from "../components/sections/home/CaseStudiesSection.astro";
import TestimonialsSection from "../components/sections/home/TestimonialsSection.astro";
import AboutSection from "../components/sections/home/AboutSection.astro";
import FAQSection from "../components/sections/home/FAQSection.astro";
---

<Layout>
  <div class="home-page">
    <Background className="portfolio-background">
      <Hero data={p} featured={Object.values(caseStudyDetails)[0]} />
      <TrustSection />
    </Background>
    <ProblemsSection />
    <Background variant="bottom" className="portfolio-background bottom">
      <ServicesSection />
    </Background>
    <ResourceSection />
    <ProjectsSection />
    <CaseStudiesSection />
    <TestimonialsSection />
    <AboutSection />
    <FAQSection />
    <Background variant="bottom" className="portfolio-background bottom">
      <div id="cta">
        <CTA />
      </div>
    </Background>
  </div>
</Layout>
