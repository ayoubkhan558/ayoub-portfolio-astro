---
import Intro from "../components/portfolio/Intro.astro";
import { sections, highlights } from "../data/privacy-policy";
import LegalSections from "../components/sections/legal/LegalSections.astro";
import Layout from "../layouts/PortfolioLayout.astro";
---

<Layout title="Privacy Policy">
  <div class="portfolio-background">
    <Intro
      label="Legal"
      title="Privacy Policy"
      description="How contact details, project information, analytics, and support records are handled."
    />
  </div>
  <article class="section wrap prose-narrow">
    <p class="eyebrow">Last updated: June 28, 2026</p>
    <div class="two-grid legal-highlights">
      {highlights.map((h) => (
        <div class="plain-card">
          <>
            <span class="eyebrow">{h.label}</span>
            <p>{h.value}</p>
          </>
        </div>
      ))}
    </div>
    <LegalSections
      sections={sections}
      sectionClass="privacy-policy-content-section"
    />
  </article>
</Layout>
