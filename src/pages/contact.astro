---
import FAQ from "../components/portfolio/FAQ.astro";
import Intro from "../components/portfolio/Intro.astro";
import p from "../data/portfolio.json";
import Layout from "../layouts/PortfolioLayout.astro";
const formId = import.meta.env.PUBLIC_FORMSPREE_ID || "mgojyyqd";
const projectTypes = [
  "Business website redesign",
  "WordPress / Bricks Builder build",
  "WooCommerce store improvement",
  "React / Next.js front end",
  "Landing page or funnel",
  "Existing site speed or cleanup",
];
const budgets = [
  "Under $1,000",
  "$1,000 - $3,000",
  "$3,000 - $7,500",
  "$7,500+",
  "Not sure yet",
];
const timelines = [
  "ASAP",
  "2-4 weeks",
  "1-2 months",
  "Flexible / planning ahead",
];
---

<Layout title="Contact"
  ><div class="template-background">
    <Intro
      label={p.sections.contact.label}
      title={p.sections.contact.title}
      description={p.sections.contact.subtitle}
    /><section class="section wrap first-section contact-layout">
      <div class="contact-info">
        <div class="contact-availability"><span class="eyebrow">Available for</span><span class="availability"><i></i>{p.profile.availability}</span></div><h2
          class="spaced"
        >
          Let's build something useful.
        </h2><p>{p.profile.summary}</p><a
          class="contact-link"
          href={`mailto:${p.profile.email}`}
          ><span>Email</span>{p.profile.email} ↗</a
        ><a
          class="contact-link"
          href={`tel:${p.profile.phone.replaceAll(" ", "")}`}
          ><span>Phone</span>{p.profile.phone} ↗</a
        ><a
          class="contact-link"
          href={p.profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"><span>Connect</span>LinkedIn ↗</a
        ><a
          class="contact-link"
          href={p.profile.upwork}
          target="_blank"
          rel="noopener noreferrer"><span>Hire</span>Upwork ↗</a
        ><p class="spaced">Based in {p.profile.location}</p>
      </div><form
        class="contact-form"
        id="contact-form"
        method="POST"
        action={`https://formspree.io/f/${formId}`}
      >
        <span class="eyebrow">Project brief</span><h2>What to send.</h2><p>
          Give me enough context to price the next step without a long discovery
          call.
        </p><div class="form-message" id="form-message" role="status" aria-live="polite" tabindex="-1" hidden></div><div class="form-grid">
          <label class="form-field"
            >Name<input
              name="name"
              autocomplete="name"
              placeholder="Your name"
              required
            /></label
          ><label class="form-field"
            >Email<input
              name="email"
              type="email"
              autocomplete="email"
              placeholder="you@company.com"
              required
            /></label>
        </div><label class="form-field"
          >Subject<input
            name="_subject"
            placeholder="Website build estimate"
            required
          /></label
        ><label class="form-field"
          >Project type<select name="projectType" required
            ><option value="" disabled selected>Choose one</option>{
              projectTypes.map((v) => <option>{v}</option>)
            }</select
          ></label
        ><div class="form-grid spaced">
          <label class="form-field"
            >Budget range<select name="budgetRange"
              ><option value="" selected>Choose one</option>{
                budgets.map((v) => <option>{v}</option>)
              }</select
            ></label
          ><label class="form-field"
            >Timeline<select name="timeline"
              ><option value="" selected>Choose one</option>{
                timelines.map((v) => <option>{v}</option>)
              }</select
            ></label>
        </div><label class="form-field"
          >Website or reference link<input
            name="websiteUrl"
            type="url"
            placeholder="https://"
          /></label
        ><label class="form-field"
          >Project details<textarea
            name="message"
            placeholder="Your goals, current blockers, reference links, and what success looks like…"
            required></textarea></label
        ><input
          type="text"
          name="_gotcha"
          tabindex="-1"
          aria-hidden="true"
          autocomplete="off"
        /><button class="button" type="submit" id="send-brief"
          >Send project brief ↗</button
        ><p class="consent">
          By submitting, you agree to the <a href="/privacy-policy/"
            >privacy policy</a
          >. Prefer email? <a href={`mailto:${p.profile.email}`}
            >Write directly</a
          >.
        </p>
      </form>
    </section>
  </div><section class="section wrap">
    <FAQ />
  </section></Layout
>
<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form")!;
  form.noValidate = true;
  const params = new URLSearchParams(location.search);
  (form.elements.namedItem("_subject") as HTMLInputElement).value = params.get("subject") || "";
  (form.elements.namedItem("message") as HTMLTextAreaElement).value = params.get("details") || "";
  const status = document.querySelector<HTMLElement>("#form-message")!;
  const button = document.querySelector<HTMLButtonElement>("#send-brief")!;
  const fields = [...form.querySelectorAll<HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement>("input:not([name='_gotcha']),select,textarea")];
  for (const field of fields) {
    const error = document.createElement("span");
    error.className = "field-error";
    error.id = `error-${field.name}`;
    error.hidden = true;
    field.after(error);
    field.setAttribute("aria-describedby", error.id);
    field.addEventListener("input", () => { if(field.validity.valid) {field.removeAttribute("aria-invalid"); error.hidden=true;} });
  }
  function showStatus(text: string, error=false) {
    status.hidden=false;
    status.classList.toggle("error",error);
    status.setAttribute("role",error ? "alert":"status");
    status.setAttribute("aria-live",error ? "assertive":"polite");
    status.textContent=text;
    status.focus({preventScroll:true});
    status.scrollIntoView({behavior: "instant",block:"center"});
  }
  let sending=false;
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if(sending) return;
    let first: typeof fields[number] | undefined;
    for(const field of fields) {
      const error=document.getElementById(`error-${field.name}`)!;
      const invalid=!field.validity.valid;
      error.hidden=!invalid;
      if(invalid) {field.setAttribute("aria-invalid","true"); error.textContent=field.validity.valueMissing ? "Please complete this field." : field.validity.typeMismatch ? `Please enter a valid ${field.type === "email" ? "email address" : "website URL (https://…)"}.` : field.validationMessage; first ??=field;}
      else field.removeAttribute("aria-invalid");
    }
    if(first) {showStatus("Please check the highlighted fields before sending.",true);first.focus();return;}
    sending=true; button.disabled=true;button.textContent="Sending…";form.setAttribute("aria-busy","true");
    showStatus("Sending your project brief…");
    const controller=new AbortController();
    const timeout=window.setTimeout(()=>controller.abort(),15000);
    try {
      const response=await fetch(form.action,{method:"POST",body:new FormData(form),headers:{Accept:"application/json"},signal:controller.signal});
      const payload=await response.json().catch(()=>({}));
      if(!response.ok || payload.ok === false) {
        const errors=Array.isArray(payload.errors) ? payload.errors : [];
        for(const item of errors) {
          const field=fields.find(f=>f.name===item.field);
          if(field) {field.setAttribute("aria-invalid","true");const error=document.getElementById(`error-${field.name}`)!;error.hidden=false;error.textContent=String(item.message || "Please check this field.");}
        }
        throw new Error(errors.map((item:{message?:string})=>item.message).filter(Boolean).join(" ") || "Please try again or use the direct email link above.");
      }
      form.reset();
      showStatus("Thanks. Your project brief has been sent. I'll review it and reply with the next practical step.");
    } catch(error) {
      const detail=controller.signal.aborted ? "Sending took too long." : error instanceof TypeError ? "Check your internet connection and try again." : error instanceof Error ? error.message : "Please try again.";
      showStatus(`The brief could not be sent. ${detail} Your details are still here. You can also use the direct email link above.`,true);
    } finally {clearTimeout(timeout);sending=false;form.setAttribute("aria-busy","false");button.disabled=false;button.textContent="Send project brief ↗";}
  });
</script>
