---
import Intro from "../components/portfolio/Intro.astro";
import Layout from "../layouts/PortfolioLayout.astro";
import ContactDetailsSection from "../components/sections/contact/ContactDetailsSection.astro";
import FAQSection from "../components/sections/contact/FAQSection.astro";
---

<Layout title="Contact">
  <div class="portfolio-background">
    <Intro
      label="Work together"
      title="Got a project? Let's talk."
      description="Tell me what you're building."
    />
    <ContactDetailsSection />
  </div>
  <FAQSection />
</Layout>
<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form")!;
  form.noValidate = true;
  const params = new URLSearchParams(location.search);
  (form.elements.namedItem("_subject") as HTMLInputElement).value =
    params.get("subject") || "";
  (form.elements.namedItem("message") as HTMLTextAreaElement).value =
    params.get("details") || "";
  const status = document.querySelector<HTMLElement>("#form-message")!;
  const button = document.querySelector<HTMLButtonElement>("#send-brief")!;
  const fields = [
    ...form.querySelectorAll<
      HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
    >("input:not([name='_gotcha']),select,textarea"),
  ];
  for (const field of fields) {
    const error = document.createElement("span");
    error.className = "field-error";
    error.id = `error-${field.name}`;
    error.hidden = true;
    field.after(error);
    field.setAttribute("aria-describedby", error.id);
    field.addEventListener("input", () => {
      if (field.validity.valid) {
        field.removeAttribute("aria-invalid");
        error.hidden = true;
      }
    });
  }
  function showStatus(text: string, error = false) {
    status.hidden = false;
    status.classList.toggle("error", error);
    status.setAttribute("role", error ? "alert" : "status");
    status.setAttribute("aria-live", error ? "assertive" : "polite");
    status.textContent = text;
    status.focus({ preventScroll: true });
    status.scrollIntoView({ behavior: "instant", block: "center" });
  }
  let sending = false;
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (sending) return;
    let first: (typeof fields)[number] | undefined;
    for (const field of fields) {
      const error = document.getElementById(`error-${field.name}`)!;
      const invalid = !field.validity.valid;
      error.hidden = !invalid;
      if (invalid) {
        field.setAttribute("aria-invalid", "true");
        error.textContent = field.validity.valueMissing
          ? "Please complete this field."
          : field.validity.typeMismatch
            ? `Please enter a valid ${field.type === "email" ? "email address" : "website URL (https://…)"}.`
            : field.validationMessage;
        first ??= field;
      } else field.removeAttribute("aria-invalid");
    }
    if (first) {
      showStatus("Please check the highlighted fields before sending.", true);
      first.focus();
      return;
    }
    sending = true;
    button.disabled = true;
    button.textContent = "Sending…";
    form.setAttribute("aria-busy", "true");
    showStatus("Sending your project brief…");
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 15000);
    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
        signal: controller.signal,
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || payload.ok === false) {
        const errors = Array.isArray(payload.errors) ? payload.errors : [];
        for (const item of errors) {
          const field = fields.find((f) => f.name === item.field);
          if (field) {
            field.setAttribute("aria-invalid", "true");
            const error = document.getElementById(`error-${field.name}`)!;
            error.hidden = false;
            error.textContent = String(
              item.message || "Please check this field.",
            );
          }
        }
        throw new Error(
          errors
            .map((item: { message?: string }) => item.message)
            .filter(Boolean)
            .join(" ") ||
            "Please try again or use the direct email link above.",
        );
      }
      form.reset();
      showStatus(
        "Thanks. Your project brief has been sent. I'll review it and reply with the next practical step.",
      );
    } catch (error) {
      const detail = controller.signal.aborted
        ? "Sending took too long."
        : error instanceof TypeError
          ? "Check your internet connection and try again."
          : error instanceof Error
            ? error.message
            : "Please try again.";
      showStatus(
        `The brief could not be sent. ${detail} Your details are still here. You can also use the direct email link above.`,
        true,
      );
    } finally {
      clearTimeout(timeout);
      sending = false;
      form.setAttribute("aria-busy", "false");
      button.disabled = false;
      button.textContent = "Send project brief ↗";
    }
  });
</script>
