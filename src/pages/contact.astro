---
import ToolPathMarquee from "../components/effects/ToolPathMarquee.astro";
import Intro from "../components/portfolio/Intro.astro";
import Layout from "../layouts/PortfolioLayout.astro";
import "../styles/contact.scss";
import ContactDetailsSection from "../components/sections/contact/ContactDetailsSection.astro";
import portfolio from "../data/portfolio.json";
import FAQSection from "../components/sections/shared/FAQSection.astro";

const emojis = ["👋", "💬", "💡", "🎨", "✏️", "🧩", "💻", "⚡", "🛒", "🛠️", "🤝", "🚀"];
---

<Layout title="Contact">
  <div class="portfolio-background">
    <Intro
      title="Tell me about your project"
      description="Share what you need, any deadline you’re working toward, and a link to your current site if you have one."
    />
    <ContactDetailsSection />
  </div>
  <div class="section-spacing" id="contact-marquee">
    <ToolPathMarquee fullWidth labels={emojis} />
  </div>
  <FAQSection id="contact-faq" items={portfolio.faqs}>
    <Fragment slot="description">Answers to common questions about working together.</Fragment>
  </FAQSection>
</Layout>

<style>
  #contact-marquee :global([data-tool-path-word]) {
    font-size: clamp(1.35rem, 3vw, 2rem);
  }
</style>
