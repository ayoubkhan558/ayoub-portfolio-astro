---
import Intro from "../components/portfolio/Intro.astro";
import { sections, highlights } from "../data/terms-and-conditions";
import LegalSections from "../components/sections/legal/LegalSections.astro";
import Layout from "../layouts/PortfolioLayout.astro";
---

<Layout title="Terms and Conditions">
  <div class="portfolio-background">
    <Intro
      label="Legal"
      title="Terms and Conditions"
      description="General terms for website use, project scope, payment, delivery, ownership, and support."
    />
  </div>
  <article class="legal-policy section-spacing">
    <div class="container prose-narrow">
      <p class="eyebrow">Last updated: June 28, 2026</p>
      <div class="legal-highlights legal-policy__columns">
        {highlights.map((h) => (
          <div class="plain-card">
            <>
              <span class="eyebrow">{h.label}</span>
              <p class="legal-highlights__description">{h.value}</p>
            </>
          </div>
        ))}
      </div>
      <LegalSections
        sections={sections}
        sectionClass="terms-and-conditions-content-section"
      />
    </div>
  </article>
</Layout>
