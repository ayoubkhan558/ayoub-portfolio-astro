---
import CTA from "../../components/portfolio/CTA.astro";
import Intro from "../../components/portfolio/Intro.astro";
import ServiceDetailSection from "../../components/sections/services/ServiceDetailSection.astro";
import { serviceDetails } from "../../data/serviceCatalog";
import Layout from "../../layouts/PortfolioLayout.astro";
import ExternalArrow from "../../components/portfolio/ExternalArrow.astro";
export function getStaticPaths() {
  return serviceDetails.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}
const { service: s } = Astro.props;
---

<Layout title={s.title} description={s.description}>
  <div class="service-detail-page">
    <div class="portfolio-background">
      <Intro label={s.label} title={s.h1} description={s.description}>
        <dl class="service-summary">
          <div>
            <dt class="service-summary__term">What’s included</dt>
            <dd class="service-summary__value">{s.sections[0]?.paragraphs[0] || s.description}</dd>
          </div>
          <div>
            <dt class="service-summary__term">Pricing</dt>
            <dd class="service-summary__value">{s.price ?? "Custom quote"}</dd>
          </div>
          <div>
            <dt class="service-summary__term">Next step</dt>
            <dd class="service-summary__value">Send your project details for an estimate.</dd>
          </div>
        </dl>
        <div class="service-detail__actions">
          <a
            class="button"
            href={`/contact/?subject=${encodeURIComponent(s.title)}`}
          >
            Discuss your project <ExternalArrow />
          </a>
          <a class="text-link" href="/services/">
            All services →
          </a>
        </div>
      </Intro>
      <div class="service-related service-detail__cards">
        {s.highlights.map((h) => (
          <article class="plain-card">
            <>
              <span class="eyebrow">{h.label}</span>
              <h3 class="plain-card__title">{h.value}</h3>
            </>
          </article>
        ))}
      </div>
    </div>
    <ServiceDetailSection service={s} />
    <div class="portfolio-background portfolio-background--bottom">
      <CTA />
    </div>
  </div>
</Layout>
