---
import CaseStudiesSection from "../../components/sections/shared/CaseStudiesSection.astro";
import CTA from "../../components/portfolio/CTA.astro";
import Intro from "../../components/portfolio/Intro.astro";
import Layout from "../../layouts/PortfolioLayout.astro";
import "../../styles/case-studies.scss";

const description =
  "Explore my website designer portfolio and see what each client needed, what I changed, and how it turned out.";
---

<Layout
  hasFooterCta
  title="Website Designer Portfolio"
  description={description}
  image="/social/ayoub-portfolio-thumbnail-case-studies.jpg"
>
  <div class="portfolio-background">
    <Intro title="Website designer portfolio" description={description} />
    <CaseStudiesSection opening label="Client case studies" />
  </div>
  <CTA />
</Layout>
