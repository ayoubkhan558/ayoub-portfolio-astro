---
import CTA from "../../components/portfolio/CTA.astro";
import Intro from "../../components/portfolio/Intro.astro";
import OverviewSection from "../../components/sections/case-study/OverviewSection.astro";
import ChallengesSection from "../../components/sections/case-study/ChallengesSection.astro";
import BrandingSection from "../../components/sections/case-study/BrandingSection.astro";
import ShowcaseSection from "../../components/sections/case-study/ShowcaseSection.astro";
import ImplementationSection from "../../components/sections/case-study/ImplementationSection.astro";
import QuoteSection from "../../components/sections/case-study/QuoteSection.astro";
import data from "../../data/caseStudyDetails.json";
import { caseStudySeo } from "../../data/caseStudySeo";
import Asset from "../../components/portfolio/Asset.astro";
import Layout from "../../layouts/PortfolioLayout.astro";
export function getStaticPaths() {
  return Object.values(data).map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}
const { study: s } = Astro.props;
const seo = caseStudySeo[s.slug];
const all = Object.values(data);
const i = all.findIndex((study) => study.slug === s.slug);
const next = all[(i + 1) % all.length];
---

<Layout
  title={seo?.title || s.client}
  description={seo?.description || s.tagline}
  image={s.heroMockup}
>
  <div class="case-detail">
    <div class="portfolio-background">
      <Intro label={s.eyebrow} title={s.headline} description={s.tagline}>
        <div class="actions">
          <a
            class="button"
            href={s.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Visit {s.urlLabel} ↗
          </a>
          <a href="/case-studies/" class="text-link">
            All case studies →
          </a>
        </div>
        <div class="tags spaced">
          <span>{s.timeline}</span>
          <span>{s.caseType}</span>
          {s.listing.stack.map((t) => (
            <span>{t}</span>
          ))}
        </div>
      </Intro>
      <div class="wrap">
        <Asset
          src={s.heroMockup}
          alt={`${s.client} website mockup`}
          class="case-hero"
          eager
        />
      </div>
      <OverviewSection study={s} />
    </div>
    <ChallengesSection study={s} />
    <BrandingSection study={s} />
    <ShowcaseSection study={s} />
    <ImplementationSection study={s} />
    <QuoteSection study={s} next={next} />
    <div class="portfolio-background bottom">
      <CTA title={s.cta.heading} text={s.cta.text} button={s.cta.buttonText} />
    </div>
  </div>
</Layout>

<script>
  for (const frame of document.querySelectorAll<HTMLAnchorElement>(
    ".screenshot-window",
  )) {
    const image = frame.querySelector<HTMLImageElement>("img");
    if (!image) continue;
    const update = () => {
      const distance = Math.max(
        0,
        image.getBoundingClientRect().height - frame.clientHeight,
      );
      frame.style.setProperty("--screenshot-distance", `${-distance}px`);
      frame.style.setProperty(
        "--screenshot-duration",
        `${Math.max(2, distance / 150)}s`,
      );
    };
    image.addEventListener("load", update);
    new ResizeObserver(update).observe(frame);
    update();
  }
</script>
