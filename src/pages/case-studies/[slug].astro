---
import Asset from "../../components/portfolio/Asset.astro";
import CTA from "../../components/portfolio/CTA.astro";
import Heading from "../../components/portfolio/Heading.astro";
import Intro from "../../components/portfolio/Intro.astro";
import ValueTree from "../../components/portfolio/ValueTree.astro";
import data from "../../data/caseStudyDetails.json";
import { caseStudySeo } from "../../data/caseStudySeo";
import { toolCatalog as tools } from "../../data/toolCatalog";
import Layout from "../../layouts/PortfolioLayout.astro";
export function getStaticPaths() {
  return Object.values(data).map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}
const { study: s } = Astro.props;
const seo = caseStudySeo[s.slug];
const all = Object.values(data);
const i = all.findIndex((study) => study.slug === s.slug);
const next = all[(i + 1) % all.length];
---

<Layout
  title={seo?.title || s.client}
  description={seo?.description || s.tagline}
  image={s.heroMockup}
>
  <div class="case-detail">
    <div class="portfolio-background">
      <Intro label={s.eyebrow} title={s.headline} description={s.tagline}>
        <div class="actions">
          <a
            class="button"
            href={s.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Visit {s.urlLabel} ↗
          </a>
          <a href="/case-studies/" class="text-link">
            All case studies →
          </a>
        </div>
        <div class="tags spaced">
          <span>{s.timeline}</span>
          <span>{s.caseType}</span>
          {s.listing.stack.map((t) => (
            <span>{t}</span>
          ))}
        </div>
      </Intro>
      <div class="wrap">
        <Asset
          src={s.heroMockup}
          alt={`${s.client} website mockup`}
          class="case-hero"
          eager
        />
      </div>
      <section class="section wrap">
        <Heading
          label="The brief"
          title="Project overview"
          subtitle={s.overview}
        />
        <div class="facts-grid">
          {s.facts.map((f) => (
            <article>
              <>
                <span class="eyebrow">{f.label}</span>
                <p>{f.value}</p>
              </>
            </article>
          ))}
        </div>
        <p class="result-highlight">{s.listing.achievement}</p>
      </section>
    </div>
    <section class="section wrap">
      <div class="two-grid">
        <div>
          <span class="eyebrow">Before</span>
          <h2>The challenges</h2>
          {s.challenges.map((c) => (
            <article class="challenge-item">
              <>
                <h3>{c.title}</h3>
                <p>{c.text}</p>
              </>
            </article>
          ))}
        </div>
        <div>
          <span class="eyebrow">After</span>
          <h2>The results</h2>
          {s.results.map((c) => (
            <article class="challenge-item">
              <>
                <h3>{c.title}</h3>
                <p>{c.text}</p>
              </>
            </article>
          ))}
        </div>
      </div>
      <p class="result-highlight">{s.performanceNote}</p>
      {"pageSpeed" in s && (
        <details class="plain-card">
          <>
            <summary>PageSpeed Insights · original measured results</summary>
            <ValueTree value={s.pageSpeed} />
          </>
        </details>
      )}
    </section>
    <section class="section wrap">
      <Heading
        label="Visual identity"
        title={s.branding.title}
        subtitle={s.branding.text}
      />
      <div class="branding-grid">
        <div class="brand-preview">
          {"logoImage" in s.branding && (
            <Asset
              src={s.branding.logoImage}
              alt={`${s.client} logo`}
              class="branding-logo"
            />
          )}
          <strong>{s.branding.logoMark}</strong>
        </div>
        <div>
          <h3>{s.branding.fontName}</h3>
          <p>{s.branding.fontMeta}</p>
          <div class="tags">
            {s.branding.fontFamilies.map((f) => (
              <span>{f}</span>
            ))}
          </div>
          <div class="palette">
            {s.branding.palette.map((c) => (
              <div>
                <>
                  <div class="swatch" style={{ backgroundColor: c.value }} />
                  <strong>{c.label}</strong>
                  <small>{c.value}</small>
                </>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
    <section class="section wrap">
      <Heading
        label={s.pageShowcase.label}
        title={s.pageShowcase.title}
        subtitle={s.pageShowcase.text}
      />
      <div class="showcase-grid">
        {s.pageShowcase.items.map((item) => (
          <figure>
            <>
              <a
                class="screenshot-window"
                href={item.image}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`View full screenshot: ${item.label}`}
              >
                <Asset
                  src={item.image}
                  alt={item.label}
                  class="full-page-image"
                />
              </a>
              <figcaption>
                <>
                  <h3>{item.label}</h3>
                  <p>{item.caption}</p>
                </>
              </figcaption>
            </>
          </figure>
        ))}
      </div>
    </section>
    <section class="section wrap">
      <Heading label="The details" title="Built for every screen." />
      <div class="two-grid">
        <div>
          <h3>Page architecture</h3>
          <div class="link-list">
            {s.desktopPages.map((page) => (
              <div class="architecture-row">
                <>
                  <strong>{page.name}</strong>
                  <p>{page.type}</p>
                </>
              </div>
            ))}
          </div>
        </div>
        <div>
          <h3>Responsive benefits</h3>
          <ul class="check-list">
            {s.responsiveBenefits.map((v) => (
              <li>{v}</li>
            ))}
          </ul>
        </div>
      </div>
      <h3 class="spaced">Tools used</h3>
      <div class="tools-inline">
        {s.tools.map(
          (key: string) =>
            tools[key] && (
              <div>
                <>
                  <Asset
                    src={tools[key].logo}
                    alt={tools[key].name}
                    class="tool-logo"
                  />
                  <span>{tools[key].name}</span>
                </>
              </div>
            ),
        )}
      </div>
    </section>
    <section class="wrap section">
      <figure class="large-quote">
        <blockquote>“{s.testimonial.quote}”</blockquote>
        <figcaption>
          <strong>{s.testimonial.author}</strong>
          <span>{s.testimonial.meta}</span>
        </figcaption>
      </figure>
      <div class="next-case">
        <span>Next case study</span>
        <a href={next.listing.href}>{next.client} →</a>
      </div>
    </section>
    <div class="portfolio-background bottom">
      <CTA title={s.cta.heading} text={s.cta.text} button={s.cta.buttonText} />
    </div>
  </div>
</Layout>

<script>
  for (const frame of document.querySelectorAll<HTMLAnchorElement>(
    ".screenshot-window",
  )) {
    const image = frame.querySelector<HTMLImageElement>("img");
    if (!image) continue;
    const update = () => {
      const distance = Math.max(
        0,
        image.getBoundingClientRect().height - frame.clientHeight,
      );
      frame.style.setProperty("--screenshot-distance", `${-distance}px`);
      frame.style.setProperty(
        "--screenshot-duration",
        `${Math.max(2, distance / 150)}s`,
      );
    };
    image.addEventListener("load", update);
    new ResizeObserver(update).observe(frame);
    update();
  }
</script>
