---
import CTA from "../components/portfolio/CTA.astro";
import Intro from "../components/portfolio/Intro.astro";
import p from "../data/portfolio.json";
import Layout from "../layouts/PortfolioLayout.astro";
import ServiceCardsSection from "../components/sections/services/ServiceCardsSection.astro";
import NichesSection from "../components/sections/services/NichesSection.astro";
import ProcessSection from "../components/sections/services/ProcessSection.astro";
import DeliverySection from "../components/sections/services/DeliverySection.astro";
import WorkingTogetherSection from "../components/sections/services/WorkingTogetherSection.astro";
import ProjectFitSection from "../components/sections/services/ProjectFitSection.astro";
---

<Layout title="Services">
  <div class="services-page">
    <div class="portfolio-background">
      <Intro
        label="Solutions"
        title="Solutions I provide."
        description={p.profile.summary}
      />
      <ServiceCardsSection />
    </div>
    <NichesSection />
    <ProcessSection />
    <DeliverySection />
    <WorkingTogetherSection />
    <ProjectFitSection />
    <div class="portfolio-background bottom">
      <CTA />
    </div>
  </div>
</Layout>
