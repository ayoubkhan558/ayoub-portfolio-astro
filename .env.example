# Optional: production canonical URL (default is profile.website in portfolio.json)
SITE_URL=https://ayoubkhan.vercel.app
# Existing public Formspree form ID from the Next.js source (not a secret).
PUBLIC_FORMSPREE_ID=mgojyyqd
# Hide mobile PageSpeed results in project details; change to true to show desktop only.
PUBLIC_SHOW_DESKTOP_PAGESPEED_ONLY=false
# Number of projects displayed on each projects page.
PUBLIC_PROJECTS_PER_PAGE=12

# Use skills logos by default, or set emoji for the CTA hover trail.
PUBLIC_CTA_TRAIL_MODE=skills
